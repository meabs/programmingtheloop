{
  "name": "programming-the-loop",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist --force-language en",
    "preview": "astro preview",
    "check": "astro check",
    "check:content": "node scripts/check-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:content": "node --test tests/check-content/check-content.test.mjs tests/editorial.test.mjs tests/navigation.test.mjs tests/experiment-cards.test.mjs tests/results.test.mjs tests/titles.test.mjs tests/check-links.test.mjs",
    "og:build": "node scripts/build-og-images.mjs",
    "guide:build": "python3 scripts/build_guide_from_book.py",
    "guide:verify": "python3 scripts/verify_book_coverage.py"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "^0.42.6",
    "astro": "7.2.10",
    "micromark": "^4.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
