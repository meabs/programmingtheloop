---
import '../styles/global.css';
import {
  SITE_URL,
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_OG_IMAGE,
  SITE_OG_IMAGE_ALT,
  SITE_AUTHOR,
  SITE_TWITTER,
  CF_WEB_ANALYTICS_SRC,
  CF_WEB_ANALYTICS_BEACON,
  LINKS,
} from '../site';
import { getVisibleNav, isCollectionNavVisible } from '../lib/collections';
import { RSS_FEEDS } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  /**
   * Emit og:image width/height 1200×630 when the image is the site default
   * or a letterboxed experiment OG PNG. Omit for raw chart previewImages.
   */
  ogImageHasStandardSize?: boolean;
  /** Open Graph type. Use `article` for experiments, articles, architecture and news posts. */
  ogType?: 'website' | 'article';
  /** ISO date for og:article:published_time when ogType is article. */
  publishedTime?: string;
  /** JSON-LD objects (Article, Person, …). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  preloadCover?: boolean;
  /** Include this page in the site search index (Pagefind). */
  searchable?: boolean;
}

const {
  title = `${SITE_NAME} — Practical technical thinking`,
  description = SITE_DESCRIPTION,
  canonicalPath = '/',
  noindex = false,
  ogImage = SITE_OG_IMAGE,
  ogImageAlt = SITE_OG_IMAGE_ALT,
  ogImageHasStandardSize = ogImage === SITE_OG_IMAGE,
  ogType = 'website',
  publishedTime,
  jsonLd,
  preloadCover = false,
  searchable = false,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).href;
const pageTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const path = Astro.url.pathname;
const nav = await getVisibleNav();
const showArticles = await isCollectionNavVisible('articles');
const showArchitecture = await isCollectionNavVisible('architecture');
const showNews = await isCollectionNavVisible('news');
const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var key = 'ptl-theme';
          var stored = localStorage.getItem(key);
          var system = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
          var theme = stored === 'dark' || stored === 'light' ? stored : system;
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('js-motion');
          }
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogImageHasStandardSize && <meta property="og:image:width" content="1200" />}
    {ogImageHasStandardSize && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && (
      <meta property="article:author" content={SITE_AUTHOR} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE_TWITTER} />
    <meta name="twitter:creator" content={SITE_TWITTER} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    {RSS_FEEDS.map((feed) => (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={feed.title}
        href={feed.href}
      />
    ))}
    {preloadCover && <link rel="preload" href="/book-cover.png" as="image" />}
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      type="module"
      src={CF_WEB_ANALYTICS_SRC}
      data-cf-beacon={CF_WEB_ANALYTICS_BEACON}
    ></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body class="spec-body">
    <div class="page-grid" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="site-header">
      <div class="wrap nav-shell">
        <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">Programming the Loop</span>
        </a>
        <nav class="nav-cells" aria-label="Main">
          {nav.map((item) => {
            const active =
              item.href === '/'
                ? path === '/'
                : path === item.href || path.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={['nav-cell', { 'is-active': active }]}
                aria-current={active ? 'page' : undefined}
              >
                <span class="nav-num">[ {item.num} ]</span>
                <span class="nav-label">{item.label}</span>
              </a>
            );
          })}
        </nav>
        <div class="nav-tools">
          <a class="theme-toggle search-link" href="/search/" aria-label="Search the site">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="7" cy="7" r="4.5"></circle><path d="M10.5 10.5 14 14" stroke-linecap="round"></path></svg>
          </a>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle colour theme">
            <span class="theme-icon theme-icon-sun" aria-hidden="true"></span>
            <span class="theme-icon theme-icon-moon" aria-hidden="true"></span>
          </button>
          <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
        </div>
        <nav class="mobile-panel" id="mobile-menu" aria-label="Mobile" inert>
          {nav.map((item) => {
            const active =
              item.href === '/'
                ? path === '/'
                : path === item.href || path.startsWith(item.href);
            return (
              <a href={item.href} aria-current={active ? 'page' : undefined}>
                <span class="nav-num">[ {item.num} ]</span> {item.label}
              </a>
            );
          })}
          <a href="/search/">Search</a>
        </nav>
      </div>
    </header>
    <main id="main" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-inner">
        <div>
          <strong>{SITE_NAME}</strong>
          <p>Practical technical thinking · {SITE_AUTHOR}</p>
        </div>
        <div class="footer-links">
          {showArticles && <a href="/articles/">Articles</a>}
          {showArchitecture && <a href="/architecture/">Architecture</a>}
          {showNews && <a href="/news/">News</a>}
          <a href="/experiments/">Experiments</a>
          <a href="/guides/">Guides</a>
          <a href="/about/">About</a>
          <a href="/updates/">Updates</a>
          <a href="/guides/programming-the-loop/#licence">Licence</a>
          <a href="/downloads/">October 2026 PDF</a>
          <a href="https://github.com/meabs/programmingtheloop">GitHub</a>
          <a href={LINKS.discussions} rel="noopener noreferrer">Discussions</a>
          <a href="/news/rss.xml">News RSS</a>
          <a href="/experiments/rss.xml">Experiments RSS</a>
          <a href="/articles/rss.xml">Articles RSS</a>
          <a href="/architecture/rss.xml">Architecture RSS</a>
        </div>
      </div>
    </footer>
    <script>
      const key = 'ptl-theme';
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const button = document.querySelector('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('.mobile-panel');
      const header = document.getElementById('site-header');

      const applyTheme = (theme: string) => {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        try {
          localStorage.setItem(key, theme);
        } catch {}
      };

      toggle?.addEventListener('click', () => {
        applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      try {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (!localStorage.getItem(key)) applyTheme(e.matches ? 'dark' : 'light');
        });
      } catch {}

      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        menu?.classList.toggle('open', open);
        if (menu) menu.inert = !open;
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.classList.contains('open')) {
          button?.setAttribute('aria-expanded', 'false');
          menu.classList.remove('open');
          menu.inert = true;
          (button as HTMLElement)?.focus();
        }
      });

      // Editorial content stays visible immediately. Motion never gates reading.

      const onScroll = () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
