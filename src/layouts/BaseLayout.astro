---
import '../styles/global.css';
import {
  SITE_URL,
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_OG_IMAGE,
  CF_WEB_ANALYTICS_SRC,
  CF_WEB_ANALYTICS_BEACON,
} from '../site';
import { getVisibleNav, isCollectionNavVisible } from '../lib/collections';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  ogImage?: string;
  preloadCover?: boolean;
}

const {
  title = `${SITE_NAME} — Building software with coding agents`,
  description = SITE_DESCRIPTION,
  canonicalPath = '/',
  noindex = false,
  ogImage = SITE_OG_IMAGE,
  preloadCover = false,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE_URL).href;
const pageTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const path = Astro.url.pathname;
const nav = await getVisibleNav();
const showArticles = await isCollectionNavVisible('articles');
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var key = 'ptl-theme';
          var stored = localStorage.getItem(key);
          var system = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
          var theme = stored === 'dark' || stored === 'light' ? stored : system;
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('js-motion');
          }
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Garry Meaburn" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    {preloadCover && <link rel="preload" href="/book-cover.png" as="image" />}
    <!-- Cloudflare Web Analytics -->
    <script
      is:inline
      type="module"
      src={CF_WEB_ANALYTICS_SRC}
      data-cf-beacon={CF_WEB_ANALYTICS_BEACON}
    ></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body class="spec-body">
    <div class="page-grid" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="site-header">
      <div class="wrap nav-shell">
        <a class="brand" href="/" aria-label={`${SITE_NAME} home`}>
          <span class="brand-mark" aria-hidden="true"></span>
          <span class="brand-name">Programming the Loop</span>
        </a>
        <nav class="nav-cells" aria-label="Main">
          {nav.map((item) => {
            const active =
              item.href === '/'
                ? path === '/'
                : path === item.href || path.startsWith(item.href);
            return (
              <a
                href={item.href}
                class:list={['nav-cell', { 'is-active': active }]}
                aria-current={active ? 'page' : undefined}
              >
                <span class="nav-num">[ {item.num} ]</span>
                <span class="nav-label">{item.label}</span>
              </a>
            );
          })}
        </nav>
        <div class="nav-tools">
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="Toggle colour theme"
          >
            <span class="theme-icon theme-icon-sun" aria-hidden="true"></span>
            <span class="theme-icon theme-icon-moon" aria-hidden="true"></span>
          </button>
          <button
            class="menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            Menu
          </button>
        </div>
        <nav class="mobile-panel" id="mobile-menu" aria-label="Mobile">
          {nav.map((item) => (
            <a href={item.href}>
              <span class="nav-num">[ {item.num} ]</span> {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="wrap footer-inner">
        <div>
          <strong>{SITE_NAME}</strong>
          <p>Agentic build engineering · Garry Meaburn</p>
        </div>
        <div class="footer-links">
          {showArticles && <a href="/articles/">Articles</a>}
          <a href="/experiments/">Experiments</a>
          <a href="/guides/">Guides</a>
          <a href="/about/">About</a>
          <a href="/updates/">Updates</a>
          <a href="/guides/programming-the-loop/#licence">Licence</a>
          <a href="/downloads/">October 2026 PDF</a>
          <a href="https://github.com/meabs/programmingtheloop">GitHub</a>
        </div>
      </div>
    </footer>
    <script>
      const key = 'ptl-theme';
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      const button = document.querySelector('.menu-toggle');
      const menu = document.querySelector('.mobile-panel');
      const header = document.getElementById('site-header');
      const motion = root.classList.contains('js-motion');

      const applyTheme = (theme: string) => {
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        try {
          localStorage.setItem(key, theme);
        } catch (_) {}
      };

      toggle?.addEventListener('click', () => {
        applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
      });

      try {
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          if (!localStorage.getItem(key)) {
            applyTheme(e.matches ? 'dark' : 'light');
          }
        });
      } catch (_) {}

      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        menu?.classList.toggle('open', open);
      });

      const onScroll = () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      /** Split headline lines into words for staggered rise. Text stays in DOM if JS fails. */
      const prepareHeadline = () => {
        const el = document.querySelector<HTMLElement>('[data-headline]');
        if (!el || !motion) {
          el?.classList.add('is-in');
          return;
        }
        el.querySelectorAll('.headline-line').forEach((line) => {
          const text = line.textContent ?? '';
          line.textContent = '';
          text.split(/(\s+)/).forEach((token, i) => {
            if (!token) return;
            if (/^\s+$/.test(token)) {
              line.appendChild(document.createTextNode(token));
              return;
            }
            const span = document.createElement('span');
            span.className = 'word';
            span.textContent = token;
            span.style.animationDelay = `${0.08 + i * 0.06}s`;
            line.appendChild(span);
          });
        });
        requestAnimationFrame(() => el.classList.add('is-in'));
      };

      /** Count up numeric stats once when scrolled into view. Final value is already in HTML. */
      const prepareCounts = () => {
        const cells = document.querySelectorAll<HTMLElement>('[data-count]');
        if (!cells.length) return;

        const animate = (el: HTMLElement) => {
          const label = el.dataset.countLabel || el.dataset.count || el.textContent || '';
          if (!motion) {
            el.textContent = label;
            return;
          }
          const match = label.match(/^(~?)([\d,]+)(.*)$/);
          if (!match) {
            el.textContent = label;
            return;
          }
          const prefix = match[1];
          const target = parseInt(match[2].replace(/,/g, ''), 10);
          const suffix = match[3];
          if (!Number.isFinite(target)) {
            el.textContent = label;
            return;
          }
          const duration = 900;
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - t, 3);
            const n = Math.round(target * eased);
            el.textContent = `${prefix}${n.toLocaleString('en-GB')}${suffix}`;
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = label;
          };
          requestAnimationFrame(tick);
        };

        if (!motion || !('IntersectionObserver' in window)) {
          cells.forEach((el) => {
            el.textContent = el.dataset.countLabel || el.dataset.count || el.textContent || '';
          });
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              animate(entry.target as HTMLElement);
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.4 },
        );
        cells.forEach((el) => io.observe(el));
      };

      const prepareLoop = () => {
        const panel = document.querySelector('.dark-loop');
        if (!panel) return;
        if (!motion || !('IntersectionObserver' in window)) {
          panel.classList.add('is-drawn');
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-drawn');
              io.unobserve(entry.target);
            }
          },
          { threshold: 0.35 },
        );
        io.observe(panel);
      };

      prepareHeadline();
      prepareCounts();
      prepareLoop();

      const nodes = document.querySelectorAll('.reveal');
      if (motion && nodes.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        nodes.forEach((el) => io.observe(el));
      } else {
        nodes.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
