---
import type { CollectionEntry } from 'astro:content';
import ResultPlot from './ResultPlot.astro';
import { axisFor, statusText, toResultPoint, type Axis, type ResultKind, type ResultPoint } from '../../lib/results';

interface Props {
  findings: NonNullable<CollectionEntry<'experiments'>['data']['findings']>;
}

const { findings } = Astro.props;
const rows = findings.filter((f) => f.status !== 'superseded');

function displayN(n: string | number | undefined | null): string | null {
  return n !== undefined && n !== null && n !== '' ? String(n) : null;
}

// One axis per unit across the experiment, so intervals line up and can be compared by eye.
const points = rows.map((f) => toResultPoint(f));
const axes = new Map<ResultKind, Axis>();
for (const kind of ['pts', 'ratio', 'pct'] as ResultKind[]) {
  const ofKind = points.filter((p): p is ResultPoint => p !== null && p.kind === kind);
  if (ofKind.length > 0) axes.set(kind, axisFor(ofKind));
}
---
{rows.length > 0 && (
  <section class="findings-block" aria-labelledby="findings-heading">
    <h2 id="findings-heading">{rows.length === 1 ? 'Key finding' : 'Key findings'}</h2>

    <ul class="findings-list">
      {rows.map((f, i) => {
        const point = points[i];
        const label = point ? statusText(point) : null;
        return (
          <li class="finding">
            <div class="finding-main">
              <code class="finding-id">{f.id}</code>
              <p class="finding-statement">{f.statement}</p>
            </div>

            <div class="finding-extra">
              {f.detail && f.detail.length > 0 && (
                <ul class="finding-detail">
                  {f.detail.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              )}

              <p class="finding-limits">
                <span class="finding-label">Limits</span>
                {f.limits.join(' · ')}
              </p>
              <a class="finding-source" href={f.source} rel="noopener noreferrer">Source ↗</a>
            </div>

            {(f.value || f.interval || f.metric || displayN(f.n)) && (
              <div class="finding-result">
                {f.value && <p class:list={['finding-value', { 'is-long': f.value.length > 24 }]}>{f.value}</p>}
                {label && <p class:list={['finding-status', `is-${point?.status}`]}>{label}</p>}
                {point && <ResultPlot rows={[{ point }]} axis={axes.get(point.kind)!} />}
                {f.interval && (
                  <p class="finding-interval">
                    95% interval {f.interval.low} to {f.interval.high}
                    <span class="finding-method">{f.interval.method}</span>
                  </p>
                )}
                {f.metric && <p class="finding-metric"><span class="finding-label">Measure</span>{f.metric}</p>}
                {displayN(f.n) && <p class="finding-metric"><span class="finding-label">Sample</span>{displayN(f.n)}</p>}
              </div>
            )}
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .findings-block { margin: 0 0 2.25rem; }
  .findings-block h2 { margin-top: 0; }
  .findings-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-strong); }
  .finding { display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: 'main' 'result' 'extra'; gap: 1rem 2rem; margin: 0; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .finding-main { grid-area: main; }
  .finding-result { grid-area: result; }
  .finding-extra { grid-area: extra; }
  @media (min-width: 820px) { .finding { grid-template-columns: minmax(0, 1fr) 17rem; grid-template-areas: 'main result' 'extra result'; gap: 0 2rem; } .finding-main { padding-bottom: .75rem; } }

  .finding-id { display: block; margin-bottom: .35rem; font-size: .8rem; color: var(--ink-faint); }
  .finding-statement { margin: 0 0 .75rem; font-size: 1.05rem; line-height: 1.45; color: var(--ink); }
  .finding-detail { margin: 0 0 .75rem; padding: 0 0 0 1.1rem; font-size: .92rem; line-height: 1.5; color: var(--ink-muted); }
  .finding-detail li { margin: .3rem 0; overflow-wrap: anywhere; }
  .finding-limits { margin: 0 0 .6rem; font-size: .88rem; line-height: 1.5; color: var(--ink-muted); }
  .finding-label { display: inline-block; margin-right: .5rem; font: .68rem 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-faint); }
  .finding-source { font-size: .88rem; font-weight: 600; }

  .finding-result { display: grid; align-content: start; gap: .4rem; min-width: 0; padding: .1rem 0 0 1rem; border-left: 1px solid var(--line); }
  @media (max-width: 819px) { .finding-result { padding: .75rem 0; border-left: 0; border-block: 1px solid var(--line); } }
  .finding-value { margin: 0; font-size: 1.25rem; font-weight: 600; line-height: 1.2; color: var(--ink); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .finding-value.is-long { font-size: .98rem; line-height: 1.35; }
  .finding-status { margin: 0; font: .72rem 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .02em; color: var(--ink-muted); }
  .finding-status.is-excludes-null { color: var(--accent); }
  .finding-interval { margin: 0; font-size: .82rem; line-height: 1.4; color: var(--ink-muted); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .finding-method { display: block; margin-top: .15rem; font-size: .76rem; color: var(--ink-faint); }
  /* Measure and Runs read as compact label/value rows, not stacked blocks. */
  .finding-metric { display: grid; grid-template-columns: 3.6rem minmax(0, 1fr); gap: 0 .6rem; align-items: baseline; margin: 0; font-size: .82rem; line-height: 1.4; color: var(--ink-muted); overflow-wrap: anywhere; }
  .finding-metric .finding-label { margin: 0; }
</style>
