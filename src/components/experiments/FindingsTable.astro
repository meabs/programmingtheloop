---
import type { CollectionEntry } from 'astro:content';

interface Props {
  findings: NonNullable<CollectionEntry<'experiments'>['data']['findings']>;
}

const { findings } = Astro.props;
const rows = findings.filter((f) => f.status !== 'superseded');

function displayN(n: string | number | undefined | null): string {
  return n !== undefined && n !== null ? String(n) : '—';
}
---
{rows.length > 0 && (
  <section class="findings-block" aria-labelledby="findings-heading">
    <h2 id="findings-heading">Findings</h2>

    <ul class="findings-cards">
      {rows.map((f) => (
        <li class="finding-card">
          <header class="finding-card-head">
            <code class="finding-id">{f.id}</code>
            <span class="finding-value">{f.value ?? '—'}</span>
          </header>
          <p class="finding-statement">{f.statement}</p>
          <p class="finding-n"><span class="finding-label">n</span> {displayN(f.n)}</p>
          <ul class="findings-limits">
            {f.limits.map((lim) => (
              <li>{lim}</li>
            ))}
          </ul>
          <p class="finding-source">
            <a href={f.source} rel="noopener noreferrer">Source</a>
          </p>
        </li>
      ))}
    </ul>

    <div class="findings-table-wrap">
      <table class="findings-table">
        <thead>
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Statement</th>
            <th scope="col">Value</th>
            <th scope="col">n</th>
            <th scope="col">Limits</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((f) => (
            <tr>
              <td><code>{f.id}</code></td>
              <td>{f.statement}</td>
              <td>{f.value ?? '—'}</td>
              <td>{displayN(f.n)}</td>
              <td>
                <ul class="findings-limits">
                  {f.limits.map((lim) => (
                    <li>{lim}</li>
                  ))}
                </ul>
              </td>
              <td>
                <a href={f.source} rel="noopener noreferrer">Results</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}

<style>
  .findings-block {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line, #d8d2c8);
  }

  /* Mobile: stacked cards. Desktop: table. */
  .findings-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .findings-table-wrap {
    display: none;
    overflow-x: auto;
  }

  @media (min-width: 641px) {
    .findings-cards {
      display: none;
    }
    .findings-table-wrap {
      display: block;
    }
  }

  .finding-card {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line, #d8d2c8);
  }
  .finding-card:first-child {
    padding-top: 0.25rem;
  }
  .finding-card:last-child {
    border-bottom: none;
  }
  .finding-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    margin-bottom: 0.5rem;
  }
  .finding-id {
    font-size: 0.95rem;
  }
  .finding-value {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .finding-statement {
    margin: 0 0 0.65rem;
    line-height: 1.45;
  }
  .finding-n {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    color: var(--ink-faint, #6b7280);
  }
  .finding-label {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-right: 0.35rem;
  }
  .finding-source {
    margin: 0.65rem 0 0;
    font-size: 0.9rem;
  }

  .findings-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .findings-table th,
  .findings-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.65rem 0.75rem;
    border-bottom: 1px solid var(--line, #d8d2c8);
  }
  .findings-table th {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint, #6b7280);
  }
  .findings-limits {
    margin: 0;
    padding-left: 1.1rem;
  }
  .findings-limits li {
    margin: 0.15rem 0;
  }
</style>
