---
import type { CollectionEntry } from 'astro:content';

interface Props {
  findings: NonNullable<CollectionEntry<'experiments'>['data']['findings']>;
}

const { findings } = Astro.props;
const rows = findings.filter((f) => f.status !== 'superseded');

function displayN(n: string | number | undefined | null): string | null {
  return n !== undefined && n !== null && n !== '' ? String(n) : null;
}
---
{rows.length > 0 && (
  <section class="findings-block" aria-labelledby="findings-heading">
    <h2 id="findings-heading">{rows.length === 1 ? 'Key finding' : 'Key findings'}</h2>

    <ul class="findings-cards">
      {rows.map((f) => (
        <li class="finding-card">
          <div class="finding-top">
            <code class="finding-id">{f.id}</code>
            {f.value && (
              <span class:list={['finding-value', { 'is-long': f.value.length > 24 }]}>{f.value}</span>
            )}
          </div>
          <p class="finding-statement">{f.statement}</p>

          {f.detail && f.detail.length > 0 && (
            <ul class="finding-detail">
              {f.detail.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          )}

          {(f.metric || f.interval || displayN(f.n)) && (
            <dl class="finding-meta">
              {f.metric && (
                <div>
                  <dt>Measure:</dt>
                  <dd>{f.metric}</dd>
                </div>
              )}
              {f.interval && (
                <div>
                  <dt>Interval:</dt>
                  <dd>
                    {f.interval.low} to {f.interval.high}
                    <span class="finding-method">{f.interval.method}</span>
                  </dd>
                </div>
              )}
              {displayN(f.n) && (
                <div>
                  <dt>Runs:</dt>
                  <dd>{displayN(f.n)}</dd>
                </div>
              )}
            </dl>
          )}

          <div class="finding-limits">
            <span class="finding-limits-label">Limits:</span>
            <ul class="findings-limits">
              {f.limits.map((lim) => (
                <li>{lim}</li>
              ))}
            </ul>
          </div>

          <a class="finding-source" href={f.source} rel="noopener noreferrer">Source ↗</a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .findings-block {
    margin: 0 0 2.25rem;
  }
  .findings-block h2 {
    margin-top: 0;
  }

  .findings-block .findings-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .findings-block .finding-card {
    margin: 0;
    padding: 1.15rem 1.25rem 1.25rem;
    background: var(--surface, #fffcf8);
    border: 1px solid var(--line, #d8d2c8);
    border-left: 3px solid var(--accent, #0d7a72);
    border-radius: 10px;
  }

  .findings-block .finding-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.6rem;
  }
  .findings-block .finding-id {
    font-size: 0.8rem;
    color: var(--ink-faint, #6b7280);
  }
  .findings-block .finding-value {
    font-size: clamp(1.5rem, 6vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--accent, #0d7a72);
    font-variant-numeric: tabular-nums;
  }

  .findings-block .finding-value.is-long {
    flex-basis: 100%;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  .findings-block .finding-statement {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ink, #12151c);
  }

  .findings-block .finding-detail {
    margin: 0 0 1rem;
    padding: 0 0 0 1.1rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-muted, #4a5160);
  }
  .findings-block .finding-detail li {
    margin: 0.35rem 0;
    overflow-wrap: anywhere;
  }

  .findings-block .finding-meta {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line, #d8d2c8);
    border-bottom: 1px solid var(--line, #d8d2c8);
    font-size: 0.9rem;
  }
  .findings-block .finding-meta > div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
  }
  .findings-block .finding-meta dt {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint, #6b7280);
    padding-top: 0.2rem;
  }
  .findings-block .finding-meta dd {
    margin: 0;
    color: var(--ink-muted, #4a5160);
    font-variant-numeric: tabular-nums;
    overflow-wrap: anywhere;
  }
  .findings-block .finding-method {
    display: block;
    font-size: 0.8rem;
    color: var(--ink-faint, #6b7280);
  }

  .findings-block .finding-limits-label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint, #6b7280);
  }
  .findings-block .findings-limits {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }
  .findings-block .findings-limits li {
    margin: 0;
    padding: 0.45rem 0.7rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--ink-muted, #4a5160);
    background: var(--accent-soft, rgba(13, 122, 114, 0.12));
    border-radius: 999px;
  }

  .findings-block .finding-source {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
