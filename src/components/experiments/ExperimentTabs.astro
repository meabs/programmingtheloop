---
// Findings is a curated view of the experiments, not a separate section: two tabs over the same material.
interface Props {
  current: 'all' | 'findings';
}
const { current } = Astro.props;
const tabs = [
  { id: 'all', label: 'All experiments', href: '/experiments/' },
  { id: 'findings', label: 'Key findings', href: '/findings/' },
] as const;
---
<nav class="exp-tabs" aria-label="Experiments views">
  <div class="wrap">
    {tabs.map((t) => (
      <a href={t.href} class:list={['exp-tab', { 'is-current': t.id === current }]} aria-current={t.id === current ? 'page' : undefined}>{t.label}</a>
    ))}
  </div>
</nav>

<style>
  .exp-tabs { border-bottom: 1px solid var(--line); }
  .exp-tabs .wrap { display: flex; gap: 1.5rem; }
  .exp-tab {
    padding: .7rem 0 .6rem;
    color: var(--ink-muted);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .exp-tab:hover { color: var(--ink); }
  .exp-tab.is-current { color: var(--ink); border-bottom-color: var(--accent); }
  .exp-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
