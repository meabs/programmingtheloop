---
import { formatItemDate } from '../../lib/collections';

interface Props {
  kind: string;
  title: string;
  summary: string;
  href: string;
  date: Date;
}
const { kind, title, summary, href, date } = Astro.props;
---
<article class="post-card">
  <div class="post-preview" aria-hidden="true"><p>{kind}</p></div>
  <div class="post-body">
    <p class="post-meta"><span>{kind}</span><time datetime={date.toISOString()}>{formatItemDate(date)}</time></p>
    <h3 class="post-title"><a href={href}>{title}</a></h3>
    <p class="post-summary">{summary}</p>
    <span class="post-open" aria-hidden="true">Read {kind.toLowerCase()} ↗</span>
  </div>
</article>

<style>
  .post-card { position: relative; display: flex; flex-direction: column; height: 100%; min-width: 0; background: var(--surface); border: 1px solid var(--line); transition: border-color .18s ease; }
  .post-card:hover, .post-card:focus-within { border-color: var(--accent); }
  .post-card:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .post-preview { aspect-ratio: 2 / 1; display: grid; place-items: center; border-bottom: 1px solid var(--line); background: var(--accent-soft, rgba(13,122,114,.1)); }
  .post-preview p { margin: 0; font-size: clamp(1.6rem, 5vw, 2.2rem); font-weight: 700; letter-spacing: -.03em; color: var(--accent); }
  .post-body { display: flex; flex-direction: column; gap: .5rem; padding: 1rem 1.1rem 1.15rem; flex: 1; }
  .post-meta { display: flex; justify-content: space-between; gap: .75rem; margin: 0; font: .68rem 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: .05em; text-transform: uppercase; color: var(--ink-faint); }
  .post-title { margin: 0; font-size: 1.15rem; line-height: 1.3; }
  .post-title a { color: var(--ink); text-decoration: none; }
  .post-title a::after { content: ''; position: absolute; inset: 0; }
  .post-title a:focus-visible { outline: none; }
  .post-summary { margin: 0; font-size: .95rem; line-height: 1.5; color: var(--ink-muted); overflow-wrap: anywhere; }
  .post-open { margin-top: auto; padding-top: .5rem; font-size: .88rem; font-weight: 600; color: var(--accent); }
</style>
