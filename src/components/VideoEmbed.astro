---
/**
 * Click-to-play YouTube embed with a thumbnail. The thumbnail image is requested from YouTube's image host when it
 * scrolls into view (lazy, no referrer); the player itself, with its scripts and cookies, loads only when the visitor
 * presses play, and then it is the privacy-enhanced one (youtube-nocookie.com). Without JavaScript it is an ordinary
 * link to the video.
 */
import { youtubeId, isShort, youtubeThumbnail, youtubeThumbnailLarge } from '../lib/video';

interface Props {
  url: string;
  title: string;
  label?: string;
  compact?: boolean;
  id?: string;
}
const { url, title, label, compact = false, id: anchor } = Astro.props;
const videoId = youtubeId(url);
const short = isShort(url);
const text = label ?? (short ? 'Play the short here' : 'Play the video here');
const standard = videoId ? youtubeThumbnail(videoId) : '';
const thumb = videoId ? (compact ? standard : youtubeThumbnailLarge(videoId)) : '';
---
{videoId && (
  <figure
    class:list={['video-embed', short ? 'is-short' : 'is-wide', compact && 'is-compact']}
    id={anchor}
    data-video-id={videoId}
    data-video-title={title}
    data-video-url={url}
  >
    <a class="video-embed-play" href={url} rel="noopener noreferrer" aria-label={`${text}: ${title}`}>
      <span class="video-embed-media">
        <img
          class="video-embed-thumb"
          src={thumb}
          data-fallback={thumb === standard ? undefined : standard}
          alt=""
          width={compact ? 480 : 1280}
          height={compact ? 360 : 720}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
        />
        <span class="video-embed-icon" aria-hidden="true">▶</span>
      </span>
      <span class="video-embed-text">
        <strong>{text}</strong>
        <small>Plays from YouTube</small>
      </span>
    </a>
  </figure>
)}

<script>
  // A missing large thumbnail falls back to the standard one; if that fails too, the grey box and play icon remain.
  document.addEventListener(
    'error',
    (event) => {
      const img = event.target;
      if (!(img instanceof HTMLImageElement) || !img.classList.contains('video-embed-thumb')) return;
      const fallback = img.dataset.fallback;
      if (fallback && img.src !== fallback) img.src = fallback;
      else img.remove();
    },
    true,
  );

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element | null)?.closest('.video-embed-play');
    const box = link?.closest<HTMLElement>('.video-embed');
    const id = box?.dataset.videoId;
    if (!link || !box || !id) return;
    event.preventDefault();
    const frame = document.createElement('iframe');
    frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`;
    frame.title = box.dataset.videoTitle ?? 'YouTube video';
    frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    frame.allowFullscreen = true;
    frame.referrerPolicy = 'strict-origin-when-cross-origin';
    const out = document.createElement('a');
    out.className = 'video-embed-out';
    out.href = box.dataset.videoUrl ?? `https://www.youtube.com/watch?v=${id}`;
    out.rel = 'noopener noreferrer';
    out.textContent = 'Open on YouTube ↗';
    box.classList.add('is-playing');
    link.replaceWith(frame, out);
    frame.focus();
  });
</script>

<style is:global>
  .video-embed { margin: 1.25rem 0; width: 100%; max-width: 40rem; }
  .video-embed.is-short { max-width: 20rem; }
  .video-embed.is-compact { margin: .75rem 0 0; max-width: 40rem; }
  .video-embed-play { display: block; color: var(--ink); text-decoration: none; }
  .video-embed-media {
    position: relative; display: block; overflow: hidden; aspect-ratio: 16 / 9;
    border: 1px solid var(--line-strong); border-radius: 8px; background: var(--surface-2);
  }
  .video-embed.is-short .video-embed-media { aspect-ratio: 9 / 16; }
  /* A vertical video sits in the middle of a wide thumbnail; cover and centre crop it to the video. */
  /* Doubled class: article text styles (.view-prose img) would otherwise win and stop the image filling the box. */
  .video-embed .video-embed-thumb { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; margin: 0; border: 0; border-radius: 0; box-shadow: none; object-fit: cover; object-position: center; }
  .video-embed-icon {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 3.25rem; height: 3.25rem; padding-left: .15rem;
    border: 2px solid var(--surface); border-radius: 50%; background: var(--accent); color: var(--surface); font-size: 1.05rem;
  }
  .video-embed-play:hover .video-embed-media, .video-embed-play:focus-visible .video-embed-media { border-color: var(--accent); }
  .video-embed-play:focus-visible { outline: none; }
  .video-embed-play:focus-visible .video-embed-media { outline: 2px solid var(--accent); outline-offset: 2px; }
  .video-embed-text { display: flex; flex-direction: column; gap: .1rem; padding-top: .55rem; min-width: 0; }
  .video-embed-text strong { font-weight: 600; }
  .video-embed-text small { color: var(--ink-muted); font-size: .8rem; }
  /* Compact: a small thumbnail beside the label, for lists. */
  .video-embed.is-compact .video-embed-play { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: .85rem; align-items: center; }
  .video-embed.is-compact.is-short .video-embed-play { grid-template-columns: 4.5rem minmax(0, 1fr); }
  .video-embed.is-compact .video-embed-icon { width: 2rem; height: 2rem; font-size: .7rem; border-width: 1.5px; }
  .video-embed.is-compact .video-embed-text { padding-top: 0; }
  .video-embed.is-playing { max-width: 40rem; }
  .video-embed.is-playing.is-short { max-width: 20rem; }
  .video-embed iframe { display: block; width: 100%; border: 0; border-radius: 8px; background: var(--surface-2); }
  .video-embed.is-short iframe { aspect-ratio: 9 / 16; }
  .video-embed.is-wide iframe { aspect-ratio: 16 / 9; }
  .video-embed-out { display: inline-block; margin-top: .5rem; font-size: .85rem; }
</style>
