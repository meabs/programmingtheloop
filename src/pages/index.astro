---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperimentCard from '../components/experiments/ExperimentCard.astro';
import PostCard from '../components/home/PostCard.astro';
import { SITE_NAME, SITE_DESCRIPTION, SITE_OG_IMAGE, LINKS, PDF_PATH } from '../site';
import {
  getHomepageSelection, getPublishedArticles, getPublishedArchitecture,
  getPublishedExperiments, getPublishedGuides, getPublishedNews,
  articleHref, architectureHref, newsHref, formatItemDate,
} from '../lib/collections';
import { personJsonLd } from '../lib/seo';

const { featured } = await getHomepageSelection();
const [articles, architecture, experiments, guides, news] = await Promise.all([
  getPublishedArticles(), getPublishedArchitecture(), getPublishedExperiments(),
  getPublishedGuides(), getPublishedNews(),
]);
// Original work leads. The featured item already has the hero. News and the guide have their own places.
const LATEST_ROW = 5;
const latestWork = [
  ...experiments.map((e) => ({ kind: 'experiment' as const, date: e.data.date, href: `/experiments/${e.id}/`, entry: e })),
  ...articles.map((a) => ({ kind: 'article' as const, date: a.data.date, href: articleHref(a), entry: a })),
  ...architecture.map((a) => ({ kind: 'architecture' as const, date: a.data.date, href: architectureHref(a), entry: a })),
]
  .filter((x) => x.href !== featured?.href)
  .sort((x, y) => y.date.valueOf() - x.date.valueOf() || x.href.localeCompare(y.href))
  .slice(0, LATEST_ROW);
const shown = new Set(latestWork.map((x) => x.href));
const latestArticles = articles.filter((a) => !shown.has(articleHref(a))).slice(0, 3);
const latestArchitecture = architecture.filter((a) => !shown.has(architectureHref(a))).slice(0, 3);
const latestNews = news.slice(0, 3);
---
<BaseLayout title={`${SITE_NAME} — Practical technical thinking`} description={SITE_DESCRIPTION} canonicalPath="/" ogImage={SITE_OG_IMAGE} jsonLd={personJsonLd()}>
  <section class="publication-hero">
    <div class="wrap publication-hero-grid">
      <div class="publication-intro">
        <p class="section-label">An independent technical publication</p>
        <h1>I measure what coding agents actually do, and publish the method and the limits.</h1>
        <p>Practical thinking on AI, software engineering, architecture and the tools we build with. Experiments I've run, with the data, and what I think they mean.</p>
        <div class="actions">
          <a class="button primary" href="/findings/">Start here →</a>
          <a class="button" href="/guides/programming-the-loop/">Read the guide →</a>
        </div>
      </div>
      {featured && <article class="editorial-feature">
        <div class="feature-meta"><span>Featured {featured.tag}</span><time datetime={featured.date.toISOString()}>{formatItemDate(featured.date)}</time></div>
        <h2><a href={featured.href}>{featured.title}</a></h2>
        <p>{featured.summary}</p>
        <a class="text-link" href={featured.href}>Read the {featured.kind} →</a>
      </article>}
    </div>
  </section>

  {latestWork.length > 0 && <section class="publication-section original-work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="publication-heading"><div><h2 id="work-title">Latest work</h2><p>Experiments, articles and architecture. Each states its method and its limits.</p></div><a class="text-link" href="/experiments/">All {experiments.length} experiments →</a></div>
      <div class="latest-row-wrap">
        <ul class="latest-row" id="latest-row" role="region" aria-label="Latest work, scroll sideways for more" tabindex="0">
          {latestWork.map((x) => (
            <li class="latest-item">
              {x.kind === 'experiment' ? <ExperimentCard item={x.entry} /> : (
                <PostCard
                  kind={x.kind === 'article' ? 'Article' : 'Architecture'}
                  title={x.entry.data.title}
                  summary={x.entry.data.summary ?? x.entry.data.description}
                  href={x.href}
                  date={x.date}
                />
              )}
            </li>
          ))}
        </ul>
        {latestWork.length > 1 && (
          <div class="latest-controls" hidden id="latest-controls">
            <button type="button" id="latest-prev" aria-label="Previous">←</button>
            <span id="latest-pos" aria-hidden="true">1 of {latestWork.length}</span>
            <button type="button" id="latest-next" aria-label="Next">→</button>
          </div>
        )}
      </div>
    </div>
  </section>}

  {guides.length > 0 && <section class="publication-section guide-feature" aria-labelledby="guide-feature-title">
    <div class="wrap guide-feature-grid">
      <img src="/book-cover.png" alt="Cover of Programming the Loop: What I Measured with Coding Agents" width="260" height="390" loading="lazy" />
      <div>
        <p class="section-label">Featured guide · Free ebook</p>
        <h2 id="guide-feature-title">Programming the Loop</h2>
        <p class="guide-subtitle">What I Measured with Coding Agents</p>
        <p>Eleven chapters of practical engineering judgement and small controlled trials, with the evidence and its limits close to each conclusion. Read it online or keep the first edition PDF.</p>
        <div class="actions"><a class="button primary" href="/guides/programming-the-loop/">Read online</a><a class="button" href={PDF_PATH} download>Download PDF ↓</a></div>
      </div>
    </div>
  </section>}

  {latestArticles.length > 0 && <section class="publication-section" aria-labelledby="articles-title">
    <div class="wrap">
      <div class="publication-heading"><div><h2 id="articles-title">Latest articles</h2></div><a class="text-link" href="/articles/">All articles →</a></div>
      <div class="publication-feed">
        {latestArticles.map((post) => <article class="feed-item">
          <div class="feed-meta"><span>Article</span><time datetime={post.data.date.toISOString()}>{formatItemDate(post.data.date)}</time></div>
          <div><h3><a href={articleHref(post)}>{post.data.title}</a></h3><p>{post.data.summary ?? post.data.description}</p></div>
          <a class="feed-arrow" href={articleHref(post)} aria-label={`Read ${post.data.title}`}>↗</a>
        </article>)}
      </div>
    </div>
  </section>}

  {latestArchitecture.length > 0 && <section class="publication-section" aria-labelledby="architecture-title">
    <div class="wrap">
      <div class="publication-heading"><div><h2 id="architecture-title">Latest architecture</h2></div><a class="text-link" href="/architecture/">All architecture →</a></div>
      <div class="publication-feed">
        {latestArchitecture.map((post) => <article class="feed-item">
          <div class="feed-meta"><span>Architecture</span><time datetime={post.data.date.toISOString()}>{formatItemDate(post.data.date)}</time></div>
          <div><h3><a href={architectureHref(post)}>{post.data.title}</a></h3><p>{post.data.summary ?? post.data.description}</p></div>
          <a class="feed-arrow" href={architectureHref(post)} aria-label={`Read ${post.data.title}`}>↗</a>
        </article>)}
      </div>
    </div>
  </section>}

  {latestNews.length > 0 && <section class="publication-section news-strip" aria-labelledby="news-title">
    <div class="wrap">
      <div class="publication-heading"><div><h2 id="news-title">News</h2><p>Relevant developments, kept short.</p></div><a class="text-link" href="/news/">All news →</a></div>
      <ul class="news-strip-list">
        {latestNews.map((post) => <li>
          <time datetime={post.data.date.toISOString()}>{formatItemDate(post.data.date)}</time>
          <a href={newsHref(post)}>{post.data.summary ?? post.data.title}</a>
        </li>)}
      </ul>
    </div>
  </section>}

  <section class="publication-section publication-about" aria-labelledby="about-title">
    <div class="wrap about-grid"><h2 id="about-title">About the publication</h2><div><p>I'm Garry Meaburn. I use this space to work through practical technical questions, share original work and offer evidence-based opinions. Findings are measured; recommendations are judgement.</p><div class="about-links"><a href="/about/">More about me →</a><a href={LINKS.githubAuthor}>GitHub ↗</a><a href={LINKS.x}>X ↗</a><a href={LINKS.linkedin}>LinkedIn ↗</a></div></div></div>
  </section>
</BaseLayout>

<script>
  // Phone-only extras on the swipe row: previous / next buttons and a position count.
  // The row scrolls and snaps without this; with no JavaScript the buttons stay hidden.
  const row = document.getElementById('latest-row');
  const controls = document.getElementById('latest-controls');
  const pos = document.getElementById('latest-pos');
  if (row && controls && pos) {
    controls.hidden = false;
    const items = Array.from(row.children) as HTMLElement[];
    const step = (dir: number) => {
      const w = (items[0]?.offsetWidth ?? 280) + 16;
      row.scrollBy({ left: dir * w, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    document.getElementById('latest-prev')?.addEventListener('click', () => step(-1));
    document.getElementById('latest-next')?.addEventListener('click', () => step(1));
    const update = () => {
      const w = (items[0]?.offsetWidth ?? 280) + 16;
      const i = Math.min(items.length - 1, Math.round(row.scrollLeft / w));
      pos.textContent = `${i + 1} of ${items.length}`;
    };
    row.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
  }
</script>
