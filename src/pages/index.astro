---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperimentCard from '../components/experiments/ExperimentCard.astro';
import { SITE_NAME, SITE_DESCRIPTION, SITE_OG_IMAGE, LINKS, PDF_PATH } from '../site';
import {
  getHomepageSelection, getPublishedArticles, getPublishedArchitecture,
  getPublishedExperiments, getPublishedGuides, getPublishedNews,
  articleHref, architectureHref, newsHref, formatItemDate,
} from '../lib/collections';
import { personJsonLd } from '../lib/seo';
import ResultPlot from '../components/experiments/ResultPlot.astro';
import Strongest from '../components/home/Strongest.astro';
import Follow from '../components/home/Follow.astro';
import HowToRead from '../components/home/HowToRead.astro';
import { latestExperiments, latestWriting } from '../lib/home-selection.mjs';
import Counts from '../components/home/Counts.astro';
import { axisFor, statusText, toResultPoint, kindCaption } from '../lib/results';
import { displayTitle } from '../lib/titles';

const { featured } = await getHomepageSelection();
const [articles, architecture, experiments, guides, news] = await Promise.all([
  getPublishedArticles(), getPublishedArchitecture(), getPublishedExperiments(),
  getPublishedGuides(), getPublishedNews(),
]);
// Cards are for experiments only; text lists are rows. The hero already shows the newest piece, so no list repeats it.
const LATEST_ROW = 5;
type ExpItem = { href: string; date: Date; entry: (typeof experiments)[number] };
const latestExp = latestExperiments(
  experiments.map((e): ExpItem => ({ href: `/experiments/${e.id}/`, date: e.data.date, entry: e })),
  featured?.href,
  LATEST_ROW,
) as ExpItem[];
type WritingItem = { kind: string; href: string; date: Date; title: string; line: string };
const writing = latestWriting(
  [
    ...articles.map((a) => ({ kind: 'Article', href: articleHref(a), date: a.data.date, title: a.data.title, line: a.data.summary ?? a.data.description })),
    ...architecture.map((a) => ({ kind: 'Architecture', href: architectureHref(a), date: a.data.date, title: a.data.title, line: a.data.summary ?? a.data.description })),
  ],
  featured?.href,
  5,
) as WritingItem[];
const latestNews = news.slice(0, 3);

// The hero shows the featured experiment's headline result as evidence, not just a title.
const featuredExp = featured ? experiments.find((e) => `/experiments/${e.id}/` === featured.href) : undefined;
const heroFindings = (featuredExp?.data.findings ?? []).filter((f) => f.status !== 'superseded');
const heroFinding = heroFindings.find((f) => f.featured) ?? heroFindings[0];
const heroPoint = toResultPoint(heroFinding);
const heroAxis = heroPoint ? axisFor([heroPoint]) : null;
---
<BaseLayout title={`${SITE_NAME} — Practical technical thinking`} description={SITE_DESCRIPTION} canonicalPath="/" ogImage={SITE_OG_IMAGE} jsonLd={personJsonLd()}>
  <section class="publication-hero">
    <div class="wrap publication-hero-grid">
      <div class="publication-intro">
        <p class="section-label">An independent technical publication</p>
        <h1>I measure what coding agents actually do, and publish the method and the limits.</h1>
        <p class="audience">For engineers deciding how to set up, check and trust coding agents.</p>
        <p>Practical thinking on AI, software engineering, architecture and the tools we build with. Experiments I've run, with the data, and what I think they mean.</p>
        <div class="actions">
          <a class="button primary" href="/findings/">Start here →</a>
          <a class="button" href="/experiments/">All experiments →</a>
        </div>
      </div>
      {featured && <article class="editorial-feature">
        <div class="feature-meta"><span>Latest {featured.tag}</span><time datetime={featured.date.toISOString()}>{formatItemDate(featured.date)}</time></div>
        <h2><a href={featured.href}>{displayTitle(featured.title)}</a></h2>
        {heroFinding && heroPoint && heroAxis ? (
          <>
            <p class="feature-finding">{heroFinding.statement}</p>
            <div class="feature-result">
              {heroFinding.value && <p class="feature-value">{heroFinding.value}</p>}
              <ResultPlot rows={[{ point: heroPoint }]} axis={heroAxis} />
              <p class="feature-caption">{kindCaption(heroPoint.kind)}{statusText(heroPoint) ? ` · ${statusText(heroPoint)}` : ''}</p>
            </div>
          </>
        ) : (
          <p>{featured.summary}</p>
        )}
        <a class="text-link" href={featured.href}>Read the {featured.kind} →</a>
      </article>}
    </div>
  </section>

  <div class="results-block">
    <Strongest heading="What the experiments show" intro="Three results to read first. The findings page groups all of them by engineering problem." />
    <HowToRead />
  </div>

  {latestExp.length > 0 && <section class="publication-section original-work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="publication-heading"><div><h2 class="section-title" id="work-title">Latest experiments</h2><p>Each states its method and its limits.</p></div><a class="text-link" href="/experiments/">All {experiments.length} experiments →</a></div>
      <div class="latest-row-wrap">
        <ul class="latest-row" id="latest-row" role="region" aria-label="Latest experiments, scroll sideways for more" tabindex="0">
          {latestExp.map((x) => (
            <li class="latest-item"><ExperimentCard item={x.entry} /></li>
          ))}
        </ul>
        {latestExp.length > 1 && (
          <div class="latest-controls" hidden id="latest-controls">
            <button type="button" id="latest-prev" aria-label="Previous">←</button>
            <span id="latest-pos" aria-hidden="true">1 of {latestExp.length}</span>
            <button type="button" id="latest-next" aria-label="Next">→</button>
          </div>
        )}
      </div>
    </div>
  </section>}

  {(writing.length > 0 || latestNews.length > 0) && <section class="publication-section" aria-labelledby="writing-title">
    <div class="wrap">
      {writing.length > 0 && <>
        <div class="publication-heading"><div><h2 class="section-title" id="writing-title">Writing</h2><p>Articles and architecture notes, newest first.</p></div><a class="text-link" href="/writing/">All writing →</a></div>
        <div class="publication-feed">
          {writing.map((post) => <article class="feed-item">
            <div class="feed-meta"><span>{post.kind}</span><time datetime={post.date.toISOString()}>{formatItemDate(post.date)}</time></div>
            <div><h3><a href={post.href}>{displayTitle(post.title)}</a></h3><p>{post.line}</p></div>
            <a class="feed-arrow" href={post.href} aria-label={`Read ${post.title}`}>→</a>
          </article>)}
        </div>
      </>}
      {latestNews.length > 0 && <div class="home-news">
        <div class="publication-heading"><div><h3 class="sub-title" id="news-title">News</h3></div><a class="text-link" href="/news/">All news →</a></div>
        <ul class="news-strip-list">
          {latestNews.map((post) => <li>
            <time datetime={post.data.date.toISOString()}>{formatItemDate(post.data.date)}</time>
            <a href={newsHref(post)}>{post.data.summary ?? post.data.title}</a>
          </li>)}
        </ul>
      </div>}
    </div>
  </section>}

  {guides.length > 0 && <section class="publication-section guide-feature" aria-labelledby="guide-feature-title">
    <div class="wrap guide-feature-grid">
      <img src="/book-cover.png" alt="Cover of Programming the Loop: What I Measured with Coding Agents" width="260" height="390" loading="lazy" />
      <div>
        <p class="section-label">Featured guide · Free ebook</p>
        <h2 class="section-title" id="guide-feature-title">Programming the Loop</h2>
        <p class="guide-subtitle">What I Measured with Coding Agents</p>
        <p>Eleven chapters of practical engineering judgement and small controlled trials, with the evidence and its limits close to each conclusion. Read it online or keep the first edition PDF.</p>
        <div class="actions"><a class="button primary" href="/guides/programming-the-loop/">Read online →</a><a class="button" href={PDF_PATH} download>Download PDF ↓</a><a class="button" href="/resources/">Resources →</a></div>
      </div>
    </div>
  </section>}

  <Follow />

  <section class="publication-section publication-about" aria-labelledby="about-title">
    <div class="wrap about-grid"><h2 class="section-title" id="about-title">About the publication</h2><div><p>I'm Garry Meaburn. I use this space to work through practical technical questions, share original work and offer evidence-based opinions. Findings are measured; recommendations are judgement.</p><div class="about-links"><a href="/about/">More about me →</a><a href={LINKS.githubAuthor}>GitHub ↗</a><a href={LINKS.x}>X ↗</a><a href={LINKS.linkedin}>LinkedIn ↗</a></div></div></div>
  </section>
</BaseLayout>

<script>
  // Phone-only extras on the swipe row: previous / next buttons and a position count.
  // The row scrolls and snaps without this; with no JavaScript the buttons stay hidden.
  const row = document.getElementById('latest-row');
  const controls = document.getElementById('latest-controls');
  const pos = document.getElementById('latest-pos');
  if (row && controls && pos) {
    controls.hidden = false;
    const items = Array.from(row.children) as HTMLElement[];
    const step = (dir: number) => {
      const w = (items[0]?.offsetWidth ?? 280) + 16;
      row.scrollBy({ left: dir * w, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    document.getElementById('latest-prev')?.addEventListener('click', () => step(-1));
    document.getElementById('latest-next')?.addEventListener('click', () => step(1));
    const update = () => {
      const w = (items[0]?.offsetWidth ?? 280) + 16;
      const i = Math.min(items.length - 1, Math.round(row.scrollLeft / w));
      pos.textContent = `${i + 1} of ${items.length}`;
    };
    row.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
  }
</script>
