---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  BOOK_SUBTITLE,
  BOOK_EDITION,
  PDF_PATH,
  LINKS,
  SITE_OG_IMAGE,
} from '../site';
---
<BaseLayout
  title={`${SITE_NAME} — Agentic engineering`}
  description={SITE_DESCRIPTION}
  canonicalPath="/"
  ogImage={SITE_OG_IMAGE}
>
  <section class="hero hero-site">
    <div class="wrap">
      <p class="edition">Garry Meaburn</p>
      <h1>
        Programming
        <span class="loop">the Loop</span>
      </h1>
      <p class="subtitle">
        Agentic engineering — working with coding agents: practices, measurements,
        experiments and notes.
      </p>
      <p class="byline">
        Modest reports of what was tried and what was measured. Corrections welcome.
      </p>
      <div class="actions">
        <a class="button primary" href="/book/">The book</a>
        <a class="button" href={LINKS.workedExample}>Worked example</a>
      </div>
    </div>
  </section>

  <section class="section" id="what">
    <div class="wrap">
      <h2>What this site is for</h2>
      <div class="prose">
        <p>
          This is a place for writing about <strong>agentic engineering</strong>: how to give
          coding agents useful work, how to check their output, and how to measure what helps
          without drowning them in context.
        </p>
        <p>
          New notes and experiments will appear here when there is something to publish. Until
          then, the main material is the free ebook and its worked example repository.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="book">
    <div class="wrap">
      <h2>Featured: the book</h2>
      <div class="feature-book">
        <div class="feature-book-visual">
          <img
            src="/book-cover.png"
            width="1600"
            height="2400"
            alt="Cover of Programming the Loop: What I Measured with Coding Agents"
          />
        </div>
        <div class="feature-book-copy">
          <p class="edition">{BOOK_EDITION}</p>
          <h3 class="feature-title">Programming the Loop</h3>
          <p class="feature-sub">{BOOK_SUBTITLE}</p>
          <div class="prose">
            <p>
              A free first-edition ebook on coding agents: what happens when you add repository
              context, when facts are missing or stale, and how verification changes the result.
              Findings come from small controlled trials with stated limits; recommendations are
              judgement and are labelled as such.
            </p>
          </div>
          <div class="actions">
            <a class="button primary" href={PDF_PATH}>Download the PDF</a>
            <a class="button" href="/book/">Book page</a>
            <a class="button" href="/contents/">Contents</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="elsewhere">
    <div class="wrap">
      <h2>Elsewhere</h2>
      <ul class="link-list">
        <li>
          <a href={LINKS.workedExample}>Worked example repository</a>
          <span class="link-note">Reproducible demonstration used in the book</span>
        </li>
        <li>
          <a href={LINKS.feedbackIssue}>Open feedback</a>
          <span class="link-note">Issues on the worked example repo</span>
        </li>
        <li>
          <a href={LINKS.x}>X · @Mav1972</a>
        </li>
        <li>
          <a href={LINKS.youtube}>YouTube · Frugal AI Engineer</a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
