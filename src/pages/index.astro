---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_DESCRIPTION, SITE_OG_IMAGE, LINKS, PDF_PATH } from '../site';
import {
  getHomepageSelection, getPublishedArticles, getPublishedExperiments,
  getPublishedGuides, getPublishedNews, experimentHref, formatItemDate,
} from '../lib/collections';

const { featured, recent } = await getHomepageSelection();
const [articles, experiments, guides, news] = await Promise.all([
  getPublishedArticles(), getPublishedExperiments(), getPublishedGuides(), getPublishedNews(),
]);
const allSections = [
  { name: 'Articles', href: '/articles/', description: 'Technical opinions, analysis and commentary.', count: articles.length },
  { name: 'Experiments', href: '/experiments/', description: 'Original research, prototypes and measured findings.', count: experiments.length },
  { name: 'Guides', href: '/guides/', description: 'Deeper practical writing and reference material.', count: guides.length },
  { name: 'News', href: '/news/', description: 'Relevant technical developments and their implications.', count: news.length },
];
// Sections with nothing published are left out rather than shown as "Coming soon".
const sections = allSections.filter((s) => s.count > 0);
---
<BaseLayout title={`${SITE_NAME} — Practical technical thinking`} description={SITE_DESCRIPTION} canonicalPath="/" ogImage={SITE_OG_IMAGE}>
  <section class="publication-hero">
    <div class="wrap publication-hero-grid">
      <div class="publication-intro">
        <p class="section-label">An independent technical publication</p>
        <h1>Exploring how technology <em>really works.</em></h1>
        <p>Practical thinking on AI, software engineering, architecture and the tools we build with. Articles, experiments, projects and guides. What I've learned, what I've measured and what I think.</p>
        <div class="actions">
          <a class="button primary" href="/findings/">Start here →</a>
          <a class="button" href="#explore">Explore the site</a>
          <a class="button" href="/guides/programming-the-loop/">Read the guide →</a>
        </div>
      </div>
      {featured && <article class="editorial-feature">
        <div class="feature-meta"><span>Featured {featured.tag}</span><time datetime={featured.date.toISOString()}>{formatItemDate(featured.date)}</time></div>
        <h2><a href={featured.href}>{featured.title}</a></h2>
        <p>{featured.summary}</p>
        <a class="text-link" href={featured.href}>Read the {featured.kind} →</a>
      </article>}
    </div>
  </section>

  <section class="publication-section" id="explore" aria-labelledby="explore-title">
    <div class="wrap">
      <div class="publication-heading"><h2 id="explore-title">Explore the site</h2><p>Choose a route into the work.</p></div>
      <div class="explore-list">
        {sections.map((section, i) => (
          <a class="explore-item" href={section.href}>
            <span class="explore-number">0{i + 1}</span><span><strong>{section.name}</strong><small>{section.description}</small></span><span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {guides.length > 0 && <section class="publication-section guide-feature" aria-labelledby="guide-feature-title">
    <div class="wrap guide-feature-grid">
      <img src="/book-cover.png" alt="Cover of Programming the Loop: What I Measured with Coding Agents" width="260" height="390" loading="lazy" />
      <div>
        <p class="section-label">Featured guide · Free ebook</p>
        <h2 id="guide-feature-title">Programming the Loop</h2>
        <p class="guide-subtitle">What I Measured with Coding Agents</p>
        <p>Eleven chapters of practical engineering judgement and small controlled trials, with the evidence and its limits close to each conclusion. Read it online or keep the first edition PDF.</p>
        <div class="actions"><a class="button primary" href="/guides/programming-the-loop/">Read online</a><a class="button" href={PDF_PATH} download>Download PDF ↓</a></div>
      </div>
    </div>
  </section>}

  {recent.length > 0 && <section class="publication-section" aria-labelledby="recent-title">
    <div class="wrap">
      <div class="publication-heading"><h2 id="recent-title">Recently published</h2><p>New writing and work across the publication.</p></div>
      <div class="publication-feed">
        {recent.map((item) => <article class="feed-item">
          <div class="feed-meta"><span>{item.tag}</span><time datetime={item.date.toISOString()}>{formatItemDate(item.date)}</time></div>
          <div><h3><a href={item.href}>{item.title}</a></h3><p>{item.summary}</p></div>
          <a class="feed-arrow" href={item.href} aria-label={`Read ${item.title}`}>↗</a>
        </article>)}
      </div>
    </div>
  </section>}

  {experiments.length > 0 && <section class="publication-section original-work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="publication-heading"><div><h2 id="work-title">Original work</h2><p>Experiments and prototypes, with the methods and limitations visible.</p></div><a class="text-link" href="/experiments/">All experiments →</a></div>
      <div class="work-list">{experiments.slice(0, 3).map((item) => <article>
        <div class="feed-meta"><span>{item.data.type}</span><time datetime={item.data.date.toISOString()}>{formatItemDate(item.data.date)}</time></div>
        <h3><a href={experimentHref(item)}>{item.data.title}</a></h3><p>{item.data.summary}</p>
        <a class="text-link" href={experimentHref(item)}>Read the work →</a>
      </article>)}</div>
    </div>
  </section>}

  <section class="publication-section publication-about" aria-labelledby="about-title">
    <div class="wrap about-grid"><h2 id="about-title">About the publication</h2><div><p>I'm Garry Meaburn. I use this space to work through practical technical questions, share original work and offer evidence-based opinions. Findings are measured; recommendations are judgement.</p><div class="about-links"><a href="/about/">More about me →</a><a href={LINKS.githubAuthor}>GitHub ↗</a><a href={LINKS.x}>X ↗</a></div></div></div>
  </section>
</BaseLayout>
