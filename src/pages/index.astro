---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperimentCard from '../components/experiments/ExperimentCard.astro';
import { SITE_NAME, SITE_DESCRIPTION, SITE_OG_IMAGE, LINKS, PDF_PATH } from '../site';
import {
  getHomepageSelection, getPublishedArticles, getPublishedExperiments,
  getPublishedGuides, getPublishedNews, articleHref, newsHref, formatItemDate,
} from '../lib/collections';

const { featured } = await getHomepageSelection();
const [articles, experiments, guides, news] = await Promise.all([
  getPublishedArticles(), getPublishedExperiments(), getPublishedGuides(), getPublishedNews(),
]);
// Original work leads. The featured item already has the hero, so the lists skip it.
const latestExperiments = experiments.filter((e) => `/experiments/${e.id}/` !== featured?.href).slice(0, 3);
const latestArticles = articles.slice(0, 3);
const latestNews = news.slice(0, 3);
---
<BaseLayout title={`${SITE_NAME} — Practical technical thinking`} description={SITE_DESCRIPTION} canonicalPath="/" ogImage={SITE_OG_IMAGE}>
  <section class="publication-hero">
    <div class="wrap publication-hero-grid">
      <div class="publication-intro">
        <p class="section-label">An independent technical publication</p>
        <h1>Exploring how technology <em>really works.</em></h1>
        <p>Practical thinking on AI, software engineering, architecture and the tools we build with. Articles, experiments, projects and guides. What I've learned, what I've measured and what I think.</p>
        <div class="actions">
          <a class="button primary" href="/findings/">Start here →</a>
          <a class="button" href="/guides/programming-the-loop/">Read the guide →</a>
        </div>
      </div>
      {featured && <article class="editorial-feature">
        <div class="feature-meta"><span>Featured {featured.tag}</span><time datetime={featured.date.toISOString()}>{formatItemDate(featured.date)}</time></div>
        <h2><a href={featured.href}>{featured.title}</a></h2>
        <p>{featured.summary}</p>
        <a class="text-link" href={featured.href}>Read the {featured.kind} →</a>
      </article>}
    </div>
  </section>

  {latestExperiments.length > 0 && <section class="publication-section original-work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="publication-heading"><div><h2 id="work-title">Latest experiments</h2><p>Original trials with the method, measures and limits on the page.</p></div><a class="text-link" href="/experiments/">All {experiments.length} experiments →</a></div>
      <div class="home-exp-grid">{latestExperiments.map((item) => <ExperimentCard item={item} />)}</div>
    </div>
  </section>}

  {guides.length > 0 && <section class="publication-section guide-feature" aria-labelledby="guide-feature-title">
    <div class="wrap guide-feature-grid">
      <img src="/book-cover.png" alt="Cover of Programming the Loop: What I Measured with Coding Agents" width="260" height="390" loading="lazy" />
      <div>
        <p class="section-label">Featured guide · Free ebook</p>
        <h2 id="guide-feature-title">Programming the Loop</h2>
        <p class="guide-subtitle">What I Measured with Coding Agents</p>
        <p>Eleven chapters of practical engineering judgement and small controlled trials, with the evidence and its limits close to each conclusion. Read it online or keep the first edition PDF.</p>
        <div class="actions"><a class="button primary" href="/guides/programming-the-loop/">Read online</a><a class="button" href={PDF_PATH} download>Download PDF ↓</a></div>
      </div>
    </div>
  </section>}

  {latestArticles.length > 0 && <section class="publication-section" aria-labelledby="articles-title">
    <div class="wrap">
      <div class="publication-heading"><div><h2 id="articles-title">Latest articles</h2></div><a class="text-link" href="/articles/">All articles →</a></div>
      <div class="publication-feed">
        {latestArticles.map((post) => <article class="feed-item">
          <div class="feed-meta"><span>Article</span><time datetime={post.data.date.toISOString()}>{formatItemDate(post.data.date)}</time></div>
          <div><h3><a href={articleHref(post)}>{post.data.title}</a></h3><p>{post.data.summary ?? post.data.description}</p></div>
          <a class="feed-arrow" href={articleHref(post)} aria-label={`Read ${post.data.title}`}>↗</a>
        </article>)}
      </div>
    </div>
  </section>}

  {latestNews.length > 0 && <section class="publication-section news-strip" aria-labelledby="news-title">
    <div class="wrap">
      <div class="publication-heading"><div><h2 id="news-title">News</h2><p>Relevant developments, kept short.</p></div><a class="text-link" href="/news/">All news →</a></div>
      <ul class="news-strip-list">
        {latestNews.map((post) => <li>
          <time datetime={post.data.date.toISOString()}>{formatItemDate(post.data.date)}</time>
          <a href={newsHref(post)}>{post.data.title}</a>
        </li>)}
      </ul>
    </div>
  </section>}

  <section class="publication-section publication-about" aria-labelledby="about-title">
    <div class="wrap about-grid"><h2 id="about-title">About the publication</h2><div><p>I'm Garry Meaburn. I use this space to work through practical technical questions, share original work and offer evidence-based opinions. Findings are measured; recommendations are judgement.</p><div class="about-links"><a href="/about/">More about me →</a><a href={LINKS.githubAuthor}>GitHub ↗</a><a href={LINKS.x}>X ↗</a><a href={LINKS.linkedin}>LinkedIn ↗</a></div></div></div>
  </section>
</BaseLayout>
