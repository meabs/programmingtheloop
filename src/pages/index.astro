---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  BOOK_SUBTITLE,
  BOOK_EDITION,
  PDF_PATH,
  LINKS,
  SITE_OG_IMAGE,
} from '../site';
import { getPublishedViews, viewHref, formatViewDate } from '../lib/views';

const latestViews = (await getPublishedViews()).slice(0, 5);
---
<BaseLayout
  title={`${SITE_NAME} — Agentic build engineering`}
  description={SITE_DESCRIPTION}
  canonicalPath="/"
  ogImage={SITE_OG_IMAGE}
>
  <section class="hero-site">
    <div class="wrap">
      <p class="edition">Garry Meaburn</p>
      <h1>
        Programming
        <span class="loop">the Loop</span>
      </h1>
      <p class="subtitle">
        Agentic build engineering: building software with coding agents.
      </p>
      <p class="byline">
        Practice on the agent loop, measurements and experiments, and views on industry trends.
      </p>
      <div class="actions">
        <a class="button primary" href="#about-site">What this site is</a>
        <a class="button" href="/book/">The book</a>
      </div>
    </div>
  </section>

  <section class="section" id="about-site">
    <div class="wrap">
      <h2>What this site is</h2>
      <div class="prose">
        <p>
          This is a place for <strong>agentic build engineering</strong>: building software with
          coding agents, and the practical engineering of the agent loop (briefs, context,
          verification, harness, review).
        </p>
        <p>
          I publish measurements and experiments when I have results worth writing up, with the
          limits stated next to the numbers.
        </p>
        <p>
          <a href="/views/">Views</a> is for short takes on industry trends and new tools or
          releases. I have not posted any yet.
        </p>
        <p>
          The free ebook <a href="/book/">Programming the Loop</a> is one part of the site. It is
          not the whole of it.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="views">
    <div class="wrap">
      <h2>Views</h2>
      {latestViews.length === 0 ? (
        <p class="lead">
          Short posts on industry trends and new tools or releases will appear here. Nothing
          published yet.
        </p>
      ) : (
        <>
          <p class="lead">Latest posts.</p>
          <ul class="link-list">
            {latestViews.map((post) => (
              <li>
                <a href={viewHref(post)}>{post.data.title}</a>
                <span class="link-note">
                  {formatViewDate(post.data.date)} · {post.data.description}
                </span>
              </li>
            ))}
          </ul>
          <p class="lead" style="margin-top:1.25rem">
            <a href="/views/">All views</a>
          </p>
        </>
      )}
    </div>
  </section>

  <section class="section" id="book">
    <div class="wrap">
      <h2>The book</h2>
      <div class="feature-book">
        <div class="feature-book-visual">
          <a href="/book/">
            <img
              src="/book-cover.png"
              width="1600"
              height="2400"
              alt="Cover of Programming the Loop: What I Measured with Coding Agents"
            />
          </a>
        </div>
        <div class="feature-book-copy">
          <p class="edition">{BOOK_EDITION}</p>
          <h3 class="feature-title">Programming the Loop</h3>
          <p class="feature-sub">{BOOK_SUBTITLE}</p>
          <div class="prose">
            <p>
              Free PDF. What I measured with coding agents in small controlled trials, with the
              limits written beside the findings.
            </p>
          </div>
          <div class="actions">
            <a class="button primary" href={PDF_PATH}>Download the PDF</a>
            <a class="button" href="/book/">Book page</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="elsewhere">
    <div class="wrap">
      <h2>Elsewhere</h2>
      <ul class="link-list">
        <li>
          <a href={LINKS.workedExample}>Worked example repository</a>
          <span class="link-note">Used through the ebook; corrections welcome via issues</span>
        </li>
        <li>
          <a href={LINKS.feedbackIssue}>Open an issue</a>
          <span class="link-note">On the worked example repo</span>
        </li>
        <li>
          <a href={LINKS.x}>X · @Mav1972</a>
        </li>
        <li>
          <a href={LINKS.youtube}>YouTube · Frugal AI Engineer</a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
