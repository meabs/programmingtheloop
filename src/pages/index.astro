---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  SITE_NAME,
  SITE_DESCRIPTION,
  SITE_OG_IMAGE,
  TOPIC_TICKER,
  LINKS,
} from '../site';
import {
  getLatestItems,
  getPublishedArticles,
  getPublishedExperiments,
  getPublishedGuides,
  articleHref,
  experimentHref,
  formatItemDate,
} from '../lib/collections';

const latest = await getLatestItems(5);
const articles = await getPublishedArticles();
const experiments = await getPublishedExperiments();
const guides = await getPublishedGuides();
const ticker = [...TOPIC_TICKER, ...TOPIC_TICKER];

const siteStats = [
  { key: 'Guides', value: String(guides.length), caption: guides.length === 1 ? guides[0].data.title : 'Published' },
  {
    key: 'Experiments',
    value: String(experiments.length),
    caption: experiments.length ? 'Published write-ups' : 'None yet',
  },
  {
    key: 'Articles',
    value: String(articles.length),
    caption: articles.length ? 'Published' : 'None yet',
  },
];
---
<BaseLayout
  title={`${SITE_NAME} — Building software with coding agents`}
  description={SITE_DESCRIPTION}
  canonicalPath="/"
  ogImage={SITE_OG_IMAGE}
>
  <section class="hero-spec">
    <div class="wrap hero-spec-grid">
      <div class="hero-main">
        <p class="section-label">§ 00 — What this is</p>
        <h1 class="hero-headline" data-headline>
          <span class="headline-line">Building software</span>
          <span class="headline-line loop">with coding agents</span>
        </h1>
        <p class="subtitle">
          Articles, experiments and guides on working with coding agents. What I measured, and
          what I think.
        </p>
        <div class="actions">
          <a class="button primary pill" href="/guides/">Browse guides</a>
          <a class="button" href="/experiments/">See experiments →</a>
        </div>
      </div>

      <aside class="hero-abstract" aria-label="Latest">
        <p class="abstract-label">Latest</p>
        <ul class="latest-list">
          {latest.map((item) => (
            <li>
              <a href={item.href}>
                <span class="latest-tag">{item.tag}</span>
                <span class="latest-title">{item.title}</span>
                <span class="latest-meta">{formatItemDate(item.date)}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="abstract-cta">
          <a class="button primary pill" href="/articles/">Articles</a>
          <a class="button" href="/about/">About</a>
        </div>
      </aside>
    </div>

    <div class="stats-strip" role="list" aria-label="What is on this site">
      {siteStats.map((stat) => (
        <div class="stat-cell" role="listitem">
          <span class="stat-key">{stat.key}</span>
          <span
            class="stat-value"
            data-count={stat.value}
            data-count-label={stat.value}
          >{stat.value}</span>
          <span class="stat-caption">{stat.caption}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="ticker-band" aria-hidden="true">
    <div class="ticker-track">
      {ticker.map((topic) => (
        <span>{topic}</span>
      ))}
    </div>
  </div>
  <p class="visually-hidden">Topics: {TOPIC_TICKER.join(', ')}.</p>

  <section class="section" id="latest">
    <div class="wrap">
      <p class="section-label reveal">§ 01 — Latest</p>
      <h2 class="reveal">Recently added</h2>
      <p class="lead reveal">Across articles, experiments and guides.</p>
      <div class="collection-grid">
        {latest.map((item) => (
          <a class="collection-card reveal" href={item.href}>
            <span class="card-kicker">{item.tag}</span>
            <time datetime={item.date.toISOString()}>{formatItemDate(item.date)}</time>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.summary}</p>
            <span class="card-meta">Open →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="articles">
    <div class="wrap">
      <p class="section-label reveal">§ 02 — Articles</p>
      <h2 class="reveal">Articles</h2>
      <p class="lead reveal">
        Short writing on trends and tools. Empty for now — that is honest.
      </p>
      {articles.length === 0 ? (
        <p class="empty-note reveal">
          Nothing published yet. <a href="/articles/">Articles index →</a>
        </p>
      ) : (
        <div class="collection-grid">
          {articles.slice(0, 3).map((post) => (
            <a class="collection-card reveal" href={articleHref(post)}>
              <span class="card-kicker">Article</span>
              <time datetime={post.data.date.toISOString()}>{formatItemDate(post.data.date)}</time>
              <h3 class="card-title">{post.data.title}</h3>
              <p class="card-desc">{post.data.summary ?? post.data.description}</p>
              <span class="card-meta">Read →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section" id="experiments">
    <div class="wrap">
      <p class="section-label reveal">§ 03 — Experiments</p>
      <h2 class="reveal">Experiments</h2>
      <p class="lead reveal">Measured trials with limits stated.</p>
      <div class="collection-grid">
        {experiments.map((item) => (
          <a class="collection-card reveal" href={experimentHref(item)}>
            <span class="card-kicker">{item.data.type}</span>
            <time datetime={item.data.date.toISOString()}>{formatItemDate(item.data.date)}</time>
            <h3 class="card-title">{item.data.title}</h3>
            <p class="card-desc">{item.data.summary}</p>
            <span class="card-meta">Open →</span>
          </a>
        ))}
      </div>
      <p class="section-more reveal">
        <a href="/experiments/">All experiments →</a>
      </p>
    </div>
  </section>

  <section class="section" id="guides">
    <div class="wrap">
      <p class="section-label reveal">§ 04 — Guides</p>
      <h2 class="reveal">Guides</h2>
      <p class="lead reveal">Longer, multi-page guides. Each stands alone.</p>
      <div class="collection-grid">
        {guides.map((item) => (
          <a class="collection-card reveal" href={item.data.href}>
            <span class="card-kicker">Guide</span>
            <time datetime={item.data.date.toISOString()}>{formatItemDate(item.data.date)}</time>
            <h3 class="card-title">{item.data.title}</h3>
            <p class="card-desc">{item.data.summary}</p>
            <span class="card-meta">Open →</span>
          </a>
        ))}
      </div>
      <p class="section-more reveal">
        <a href="/guides/">All guides →</a>
      </p>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap">
      <p class="section-label reveal">§ 05 — About</p>
      <h2 class="reveal">About and feedback</h2>
      <p class="lead reveal">
        I write as Garry Meaburn. Findings are measured; recommendations are judgement. If a
        number is wrong, <a href={LINKS.feedbackIssue}>open an issue</a>.
      </p>
      <div class="actions reveal">
        <a class="button primary pill" href="/about/">About</a>
        <a class="button" href={LINKS.feedbackIssue}>Open an issue</a>
      </div>
    </div>
  </section>
</BaseLayout>
