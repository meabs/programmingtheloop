---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page not found"
  description="This page could not be found on programmingtheloop.com."
  canonicalPath="/404.html"
  noindex={true}
>
  <header class="page-head">
    <div class="wrap">
      <h1>Page not found</h1>
      <p>That URL is not on this site. Try the home page, contents, or the PDF download.</p>
    </div>
  </header>
  <div class="page-body">
    <div class="wrap actions">
      <a class="button primary" href="/">Home</a>
      <a class="button" href="/contents/">Contents</a>
      <a class="button" href="/downloads/Programming-the-Loop-1st-edition.pdf">Download PDF</a>
    </div>
  </div>
</BaseLayout>
