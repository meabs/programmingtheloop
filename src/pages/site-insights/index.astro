---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_OG_IMAGE, LINKS } from '../../site';
import {
  getPublishedExperiments,
  getPublishedArticles,
  getPublishedArchitecture,
  getPublishedNews,
  experimentHref,
} from '../../lib/collections';
import { getTopicsWithContent } from '../../lib/topics';

const experiments = await getPublishedExperiments();

const [articles, architecture, news, topics] = await Promise.all([
  getPublishedArticles(),
  getPublishedArchitecture(),
  getPublishedNews(),
  getTopicsWithContent(),
]);

const num = (v: unknown) => (typeof v === 'number' ? v : Number.parseInt(String(v ?? '').replace(/\D/g, ''), 10) || 0);
const findings = experiments.flatMap((e) => e.data.findings ?? []).filter((f) => f.status !== 'superseded');
const totalRuns = experiments.reduce((n, e) => n + num(e.data.runs), 0);

type Bar = { label: string; value: number; href?: string };
const byTopic: Bar[] = topics.map((t) => ({ label: t.title, value: t.experiments.length, href: `/topics/${t.id}/` }));
const byRuns: Bar[] = experiments
  .map((e) => ({ label: e.data.experimentId ?? e.data.title, value: num(e.data.runs), href: experimentHref(e) }))
  .filter((b) => b.value > 0)
  .sort((a, b) => b.value - a.value);
const byFindings: Bar[] = experiments
  .map((e) => ({
    label: e.data.experimentId ?? e.data.title,
    value: (e.data.findings ?? []).filter((f) => f.status !== 'superseded').length,
    href: experimentHref(e),
  }))
  .filter((b) => b.value > 0)
  .sort((a, b) => b.value - a.value);
const charts = [
  { id: 'runs', title: 'Runs per experiment', note: 'Agent runs behind each experiment, largest first.', bars: byRuns },
  { id: 'findings', title: 'Current findings per experiment', note: 'Findings not marked superseded.', bars: byFindings },
  { id: 'topics', title: 'Experiments per topic', note: 'An experiment with two topics counts under both.', bars: byTopic },
];

const ROW = 26;
const LABEL_W = 130;
const BAR_W = 420;
const NUM_W = 56;
const chartMax = (bars: Bar[]) => Math.max(1, ...bars.map((b) => b.value));

// Traffic and feedback live behind logins, so this page only links to them.
// The charts come from the site's own content at build time, not from visitors.
const sections = [
  {
    id: 'traffic',
    title: 'Traffic',
    items: [
      {
        label: 'Cloudflare Web Analytics',
        href: 'https://dash.cloudflare.com/?to=/:account/web-analytics',
        note: 'Page views, visits, top pages, referrers, countries and Core Web Vitals for programmingtheloop.com. The beacon is already on every page.',
      },
      {
        label: 'GitHub traffic: this site\'s repository',
        href: `${LINKS.githubSite}/graphs/traffic`,
        note: 'Views, clones and referring sites for the source. GitHub keeps only the last 14 days.',
      },
      {
        label: 'GitHub traffic: experiments repository',
        href: 'https://github.com/meabs/experiments/graphs/traffic',
        note: 'Who is opening the data and reports behind each experiment, and where they came from.',
      },
      {
        label: 'Google Search Console',
        href: 'https://search.google.com/search-console?resource_id=https%3A%2F%2Fprogrammingtheloop.com%2F',
        note: 'Search queries, impressions and indexing. Works only if the domain has been verified there.',
      },
    ],
  },
  {
    id: 'reviews-and-feedback',
    title: 'Reviews and feedback',
    items: [
      { label: 'GitHub Discussions', href: LINKS.discussions, note: 'Questions, challenges and comments on the experiments.' },
      { label: 'Issues on this site', href: `${LINKS.githubSite}/issues`, note: 'Corrections and bug reports.' },
      { label: 'Stars and forks', href: LINKS.githubSite, note: 'A rough signal of who is bookmarking the project.' },
      { label: 'Mentions on X', href: 'https://x.com/search?q=programmingtheloop.com&f=live', note: 'People sharing or discussing a page.' },
    ],
  },
] as const;
---
<BaseLayout
  title="Site insights"
  description="Private shortcuts to traffic and feedback."
  canonicalPath="/site-insights/"
  ogImage={SITE_OG_IMAGE}
  noindex
>
  <header class="page-head">
    <div class="wrap">
      <p class="section-label">Private</p>
      <h1>Site insights</h1>
      <p>
        Shortcuts to traffic and feedback. This page is unlisted: it is not linked from the site, not in the sitemap and
        marked noindex. Visitor numbers sit behind your logins, so the traffic and feedback sections link to them. The
        charts below show what is published, built from the site's own content.
      </p>
      <p><a class="button primary" href="#traffic">Traffic</a> <a class="button" href="#reviews-and-feedback">Feedback</a> <a class="button" href="#published">What's published</a></p>
    </div>
    <div class="stats-strip">
      <div class="stat-cell"><span class="stat-key">Experiments</span><span class="stat-value">{experiments.length}</span></div>
      <div class="stat-cell"><span class="stat-key">Current findings</span><span class="stat-value">{findings.length}</span></div>
      <div class="stat-cell"><span class="stat-key">Agent runs</span><span class="stat-value">{totalRuns.toLocaleString('en-GB')}</span></div>
      <div class="stat-cell"><span class="stat-key">Articles</span><span class="stat-value">{articles.length}</span></div>
      <div class="stat-cell"><span class="stat-key">News posts</span><span class="stat-value">{news.length}</span></div>
    </div>
  </header>
  <div class="page-body">
    <div class="wrap">
      {sections.map((s) => (
        <section id={s.id} aria-labelledby={`${s.id}-h`}>
          <h2 id={`${s.id}-h`}>{s.title}</h2>
          <ul>
            {s.items.map((i) => (
              <li><a href={i.href} rel="noopener noreferrer" target="_blank">{i.label}</a>: {i.note}</li>
            ))}
          </ul>
        </section>
      ))}

      <section id="published" aria-labelledby="published-h">
        <h2 id="published-h">What's published</h2>
        {charts.map((c) => (
          <figure class="guide-figure" aria-labelledby={`${c.id}-t`}>
            <h3 id={`${c.id}-t`}>{c.title}</h3>
            <svg
              viewBox={`0 0 ${LABEL_W + BAR_W + NUM_W} ${c.bars.length * ROW + 4}`}
              width="100%"
              role="img"
              aria-label={`${c.title}: ${c.bars.map((b) => `${b.label} ${b.value}`).join(', ')}`}
            >
              {c.bars.map((b, i) => (
                <g transform={`translate(0 ${i * ROW + 2})`}>
                  <text x={LABEL_W - 8} y={ROW / 2 + 4} text-anchor="end" font-size="12" fill="var(--ink-muted)">
                    {b.href ? <a href={b.href}>{b.label}</a> : b.label}
                  </text>
                  <rect x={LABEL_W} y="3" height={ROW - 8} rx="3" width={Math.max(2, (b.value / chartMax(c.bars)) * BAR_W)} fill="var(--accent)" />
                  <text x={LABEL_W + Math.max(2, (b.value / chartMax(c.bars)) * BAR_W) + 6} y={ROW / 2 + 4} font-size="12" fill="var(--ink)">{b.value.toLocaleString('en-GB')}</text>
                </g>
              ))}
            </svg>
            <figcaption>{c.note}</figcaption>
          </figure>
        ))}
      </section>
    </div>
  </div>
</BaseLayout>
