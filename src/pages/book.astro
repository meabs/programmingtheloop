---
/**
 * Compatibility: /book → guide home (also declared in astro.config redirects).
 */
const dest = '/guides/programming-the-loop/';
---
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <meta http-equiv="refresh" content={`0;url=${dest}`} />
    <link rel="canonical" href={new URL(dest, 'https://programmingtheloop.com').href} />
    <script is:inline define:vars={{ dest }}>
      location.replace(dest);
    </script>
  </head>
  <body>
    <p>This page has moved to <a href={dest}>{dest}</a>.</p>
  </body>
</html>
