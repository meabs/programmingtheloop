---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  BOOK_TITLE,
  BOOK_SUBTITLE,
  BOOK_EDITION,
  BOOK_DESCRIPTION,
  BOOK_OG_IMAGE,
  PDF_PATH,
  CHAPTERS,
  LINKS,
  LICENCE_SHORT,
  LICENCE_QUOTED_HTML,
  LICENCE_DISCLAIMER_HTML,
  GUIDE_LAST_UPDATED_LABEL,
} from '../site';
---
<BaseLayout
  title={`${BOOK_TITLE}: ${BOOK_SUBTITLE}`}
  description={BOOK_DESCRIPTION}
  canonicalPath="/book/"
  ogImage={BOOK_OG_IMAGE}
  preloadCover={true}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="edition">Archive hub · {BOOK_EDITION}</p>
        <h1>
          Programming
          <span class="loop">the Loop</span>
        </h1>
        <p class="subtitle">{BOOK_SUBTITLE}</p>
        <p class="byline">
          By Garry Meaburn · Living Guide updated {GUIDE_LAST_UPDATED_LABEL}
        </p>
        <div class="actions">
          <a class="button primary" href="/guide/">Read the Guide</a>
          <a class="button" href={PDF_PATH}>Archived PDF</a>
        </div>
      </div>
      <div class="hero-visual">
        <img
          src="/book-cover.png"
          width="1600"
          height="2400"
          alt="Cover of Programming the Loop: What I Measured with Coding Agents by Garry Meaburn"
        />
      </div>
    </div>
  </section>

  <section class="section" id="living-guide">
    <div class="wrap">
      <h2>The living Guide</h2>
      <div class="prose">
        <p>
          This site is now the primary home for the full text. The Guide carries every chapter,
          checklist, table, figure and reference from the October 2026 first edition, and will be
          updated here when something needs correcting or adding.
        </p>
        <p>
          The PDF remains available as a fixed snapshot of that first edition. Prefer the
          <a href="/guide/">Guide</a> for the current wording.
        </p>
      </div>
      <div class="actions">
        <a class="button primary" href="/guide/">Guide contents</a>
        <a class="button" href="/updates/">Updates</a>
      </div>
    </div>
  </section>

  <section class="section" id="contents">
    <div class="wrap">
      <h2>Chapters</h2>
      <ol class="chapter-list">
        <li>
          <a href="/guide/foreword/">
            <span class="chapter-num">—</span>
            <span>
              <span class="chapter-title">Foreword: why I ran the experiments</span>
              <span class="chapter-sub">Findings in brief, and how findings differ from recommendations.</span>
            </span>
          </a>
        </li>
        {CHAPTERS.map((ch) => (
          <li>
            <a href={ch.href}>
              <span class="chapter-num">{String(ch.num).padStart(2, '0')}</span>
              <span>
                <span class="chapter-title">{ch.title}</span>
                <span class="chapter-sub">{ch.blurb}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="licence">
    <div class="wrap">
      <h2>Licence and archive download</h2>
      <div class="licence-box">
        <p>{LICENCE_SHORT}</p>
        <p set:html={LICENCE_QUOTED_HTML} />
        <p set:html={LICENCE_DISCLAIMER_HTML} />
        <p>
          The latest related repositories are at
          <a href={LINKS.githubAuthor}>github.com/meabs</a>.
        </p>
        <div class="actions">
          <a class="button primary" href={PDF_PATH}>Download archived first-edition PDF</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="feedback">
    <div class="wrap">
      <h2>Feedback</h2>
      <div class="prose">
        <p>
          If a number, a limit or a claim is wrong, I want to know. Prefer something concrete: which
          page, which figure, what you think it should say.
        </p>
      </div>
      <div class="feedback-links">
        <a href={LINKS.feedbackIssue}>Open an issue on the worked example</a>
        <a href={LINKS.workedExample}>Worked example repository</a>
      </div>
    </div>
  </section>
</BaseLayout>
