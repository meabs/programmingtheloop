---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperimentTabs from '../components/experiments/ExperimentTabs.astro';
import Strongest from '../components/home/Strongest.astro';
import Synthesis from '../components/home/Synthesis.astro';
import StartHere from '../components/home/StartHere.astro';
import Follow from '../components/home/Follow.astro';
import HowToRead from '../components/home/HowToRead.astro';
import Counts from '../components/home/Counts.astro';
import FindingsBrowse from '../components/home/FindingsBrowse.astro';
import { SITE_NAME, SITE_OG_IMAGE } from '../site';
---
<BaseLayout
  title={`What the experiments show — ${SITE_NAME}`}
  description="What the controlled experiments on coding agents show so far, grouped by engineering problem, each result with its limits."
  canonicalPath="/findings/"
  ogImage={SITE_OG_IMAGE}
  searchable
>
  <header class="page-head">
    <div class="wrap">
      <p class="section-label">Synthesis</p>
      <h1>What the experiments show</h1>
      <Counts />
      <p>
        This is a curated view of the same experiments: the headline results, grouped by the engineering problem they inform.
        Every number is read from the experiment it comes from, with its limits. For the full write-ups, use All experiments.
      </p>
      <p>
        <a class="button primary" href="#by-problem">By problem →</a>
        <a class="button" href="/measured/">Reference list →</a>
      </p>
    </div>
  </header>
  <ExperimentTabs current="findings" />
  <Strongest intro="If you read three, read these. Each shows the result, its interval and its limit." />
  <HowToRead />
  <Synthesis />
  <FindingsBrowse />
  <StartHere heading="Five rules to start with" level="h2" />
  <Follow />
</BaseLayout>
