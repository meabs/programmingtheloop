---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FindingsTable from '../../components/experiments/FindingsTable.astro';
import { SITE_OG_IMAGE } from '../../site';
import { formatItemDate } from '../../lib/collections';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  // Public builds omit draft:true. Set PREVIEW_DRAFTS=1 for local preview only.
  const previewDrafts = process.env.PREVIEW_DRAFTS === '1';
  const items = await getCollection('experiments', ({ data }) =>
    previewDrafts ? true : data.draft !== true,
  );
  return items.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const findings = item.data.findings ?? [];
const isDraft = item.data.draft === true;
const publishedOn = item.data.publishedOn;
---
<BaseLayout
  title={item.data.title}
  description={item.data.description}
  canonicalPath={`/experiments/${item.id}/`}
  ogImage={SITE_OG_IMAGE}
  noindex={isDraft}
>
  <header class="page-head">
    <div class="wrap">
      <p class="section-label">
        {publishedOn
          ? `${item.data.type} · ${formatItemDate(publishedOn)}`
          : item.data.type}
      </p>
      <h1>{item.data.title}</h1>
      <p>{item.data.description}</p>
      {(item.data.github.length > 0 || item.data.guideLinks.length > 0) && (
        <div class="actions">
          {item.data.guideLinks.map((link) => (
            <a class="button" href={link.href}>{link.label}</a>
          ))}
          {item.data.github.map((link) => (
            <a class="button" href={link.href} rel="noopener noreferrer">{link.label} ↗</a>
          ))}
        </div>
      )}
    </div>
  </header>
  <div class="page-body">
    <div class="wrap view-prose">
      <FindingsTable findings={findings} />
      <Content />
      <p class="view-back">
        <a href="/experiments/">← All experiments</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  // Tables with long text cells wrap like prose (class table-prose); on phones
  // each row becomes a card, using each cell's column heading as its label.
  const PROSE_CELL_CHARS = 48;
  document.querySelectorAll<HTMLTableElement>('.view-prose table').forEach((table) => {
    const rows = Array.from(table.rows);
    if (rows.length === 0) return;
    const labels = Array.from(rows[0].cells).map((c) => (c.textContent ?? '').trim());
    let longest = 0;
    for (const row of rows) {
      Array.from(row.cells).forEach((cell, i) => {
        longest = Math.max(longest, (cell.textContent ?? '').trim().length);
        if (cell.tagName === 'TD' && labels[i]) cell.dataset.label = labels[i];
      });
    }
    if (longest > PROSE_CELL_CHARS) table.classList.add('table-prose');
  });
</script>
