---
import StartHere from '../../../components/home/StartHere.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_OG_IMAGE, START_ROUTES, type StartThenPart } from '../../../site';

function isThenLink(part: StartThenPart): part is { label: string; href: string } {
  return typeof part === 'object' && part !== null && 'href' in part;
}
---
<BaseLayout
  title={`Where to start — ${SITE_NAME}`}
  description="Find the right chapter of Programming the Loop for what you're dealing with."
  canonicalPath="/guides/programming-the-loop/start/"
  ogImage={SITE_OG_IMAGE}
>
  <section class="start-page">
    <div class="wrap start-head">
      <div>
        <p class="section-label">§ 01 — Start here</p>
        <h1>Where to start</h1>
        <p class="lead">
          Pick the row that sounds like you. It tells you which chapter to read first, and where
          to go after.
        </p>
      </div>
      <a class="more-link" href="/guides/programming-the-loop/">Full Guide contents →</a>
    </div>

    <StartHere heading="The five findings behind the routes" level="h2" />
    <div class="wrap">
      <div class="start-table" role="table" aria-label="Guide routing by situation">
        <div class="start-row start-head-row" role="row">
          <div role="columnheader">01 · You have</div>
          <div role="columnheader">02 · Start with</div>
          <div role="columnheader">03 · Leads to</div>
          <div role="columnheader" class="start-action-h"><span class="visually-hidden">Open</span></div>
        </div>
        {START_ROUTES.map((row) => (
          <article class={`start-row accent-${row.accent} reveal`} role="row">
            <div role="cell" class="start-have">
              <span class="start-have-text">{row.have}</span>
            </div>
            <div role="cell" class="start-with">
              <span class="start-field-label">Read first</span>
              <a class="start-primary-link" href={row.startWith.href}>
                <span class="start-chapter">{row.startWith.label}</span>
                <span class="start-detail">{row.startWith.detail}</span>
              </a>
              <span class="start-chips">
                {row.chips.map((chip) => (
                  <span class="chip">{chip}</span>
                ))}
              </span>
            </div>
            <div role="cell" class="start-leads">
              <span class="start-field-label">Then</span>
              <span class="start-then-copy">
                {row.then.map((part) =>
                  isThenLink(part) ? (
                    <a class="start-then-link" href={part.href}>{part.label}</a>
                  ) : (
                    part
                  )
                )}
              </span>
            </div>
            <div role="cell" class="start-action">
              <a href={row.startWith.href} aria-label={`Read ${row.startWith.label}`} class="start-action-arrow">→</a>
            </div>
          </article>
        ))}
      </div>
      <p class="start-footnote">
        Numbers in chips (for example <span class="chip">+35–48%</span>,
        <span class="chip">14 / 16</span>, <span class="chip">3 → 18–19/20</span>,
        <span class="chip">12 runs</span>) come from the Foreword findings. Each has limits
        stated in the Guide.
      </p>
    </div>
  </section>
</BaseLayout>
