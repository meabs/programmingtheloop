---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostFooter from '../../components/home/PostFooter.astro';
import { getPublishedArchitecture, formatItemDate } from '../../lib/collections';
import { absoluteUrl, articleJsonLd, resolveOgImageWithAlt } from '../../lib/seo';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPublishedArchitecture();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonicalPath = `/architecture/${post.id}/`;
const og = resolveOgImageWithAlt(post.data.previewImage, post.data.previewAlt);
const publishedTime = post.data.date.toISOString();
const jsonLd = articleJsonLd({
  headline: post.data.title,
  description: post.data.description,
  url: absoluteUrl(canonicalPath),
  datePublished: post.data.date,
  image: og.url,
});
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImage={og.url}
  ogImageAlt={og.alt}
  ogImageHasStandardSize={og.hasStandardSize}
  publishedTime={publishedTime}
  jsonLd={jsonLd}

  searchable
>
  <header class="page-head">
    <div class="wrap">
      <p class="section-label">Architecture · {formatItemDate(post.data.date)}</p>
      <h1>{post.data.title}</h1>
      {post.data.video && (
        <p class="actions"><a class="button primary" href={post.data.video.url} rel="noopener noreferrer">{post.data.video.label ?? 'Watch the video'} ↗</a></p>
      )}
    </div>
  </header>
  <div class="page-body">
    <div class="wrap view-prose">
      <Content />
      <PostFooter kind="architecture" href={canonicalPath} topics={post.data.topics} />
      <p class="view-back">
        <a href="/architecture/">← All architecture</a>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  import '../../scripts/prose-enhance';
</script>
