---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_OG_IMAGE, START_ROUTES } from '../site';
---
<BaseLayout
  title={`Start — ${SITE_NAME}`}
  description="Find the right chapter of Programming the Loop for what you're dealing with."
  canonicalPath="/start/"
  ogImage={SITE_OG_IMAGE}
>
  <section class="start-page">
    <div class="wrap start-head">
      <div>
        <p class="section-label">§ 01 — Start here</p>
        <h1>/start</h1>
        <p class="lead">
          Pick the row that fits. It sends you to the right chapter, and says what that chapter
          opens up. Drawn from how the book itself is laid out.
        </p>
      </div>
      <a class="more-link" href="/guide/">Full Guide contents →</a>
    </div>

    <div class="wrap">
      <div class="start-table" role="table" aria-label="Guide routing by situation">
        <div class="start-row start-head-row" role="row">
          <div role="columnheader">01 · You have</div>
          <div role="columnheader">02 · Start with</div>
          <div role="columnheader">03 · Leads to</div>
          <div role="columnheader" class="start-action-h"><span class="visually-hidden">Open</span></div>
        </div>
        {START_ROUTES.map((row) => (
          <a class={`start-row accent-${row.accent} reveal`} href={row.startWith.href} role="row">
            <div role="cell" class="start-have">{row.have}</div>
            <div role="cell" class="start-with">
              <span class="start-chapter">{row.startWith.label}</span>
              <span class="start-detail">{row.startWith.detail}</span>
              <span class="start-chips">
                {row.chips.map((chip) => (
                  <span class="chip">{chip}</span>
                ))}
              </span>
            </div>
            <div role="cell" class="start-leads">{row.leadsTo}</div>
            <div role="cell" class="start-action" aria-hidden="true">→</div>
          </a>
        ))}
      </div>
      <p class="start-footnote">
        Numbers in chips (for example <span class="chip">+35–48%</span>,
        <span class="chip">14 / 16</span>, <span class="chip">3 → 18–19/20</span>,
        <span class="chip">12 runs</span>) come from the Foreword findings. Each has limits
        stated in the Guide.
      </p>
    </div>
  </section>
</BaseLayout>
