---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_OG_IMAGE } from '../../site';
import {
  getPublishedArticles,
  articleHref,
  formatItemDate,
} from '../../lib/collections';

const posts = await getPublishedArticles();
---
<BaseLayout
  title="Articles"
  description="Technical opinions, analysis and commentary by Garry Meaburn."
  canonicalPath="/articles/"
  ogImage={SITE_OG_IMAGE}
>
  <header class="page-head">
    <div class="wrap">
      <p class="section-label">Writing</p>
      <h1>Articles</h1>
      <p>
        Technical opinions, analysis and commentary on the engineering choices behind the tools we use.
      </p>
    </div>
  </header>
  <div class="page-body">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="empty-note">
          Nothing published here yet. New articles will appear on this page and in the homepage feed.
        </p>
      ) : (
        <div class="collection-grid">
          {posts.map((post) => (
            <a class="collection-card reveal" href={articleHref(post)}>
              <span class="card-kicker">Article</span>
              <time datetime={post.data.date.toISOString()}>{formatItemDate(post.data.date)}</time>
              <h2 class="card-title">{post.data.title}</h2>
              <p class="card-desc">{post.data.summary ?? post.data.description}</p>
              <span class="card-meta">Read →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
