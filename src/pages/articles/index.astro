---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_OG_IMAGE } from '../../site';
import {
  getPublishedArticles,
  articleHref,
  formatItemDate,
} from '../../lib/collections';

const posts = await getPublishedArticles();
---
<BaseLayout
  title="Articles"
  description="Garry Meaburn on industry trends, tools and practice with coding agents."
  canonicalPath="/articles/"
  ogImage={SITE_OG_IMAGE}
>
  <header class="page-head">
    <div class="wrap">
      <p class="section-label">§ 01 — Articles</p>
      <h1>Articles</h1>
      <p>
        Short writing on trends, tools and practice. Not part of a guide. Nothing published yet
        means an empty shelf, not a fake post.
      </p>
    </div>
  </header>
  <div class="page-body">
    <div class="wrap">
      {posts.length === 0 ? (
        <p class="empty-note">
          Nothing here yet. When I publish an article, it will show up on this page and in Latest
          on the home page.
        </p>
      ) : (
        <div class="collection-grid">
          {posts.map((post) => (
            <a class="collection-card reveal" href={articleHref(post)}>
              <span class="card-kicker">Article</span>
              <time datetime={post.data.date.toISOString()}>{formatItemDate(post.data.date)}</time>
              <h2 class="card-title">{post.data.title}</h2>
              <p class="card-desc">{post.data.summary ?? post.data.description}</p>
              <span class="card-meta">Read →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
