---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles, formatItemDate } from '../../lib/collections';
import { absoluteUrl, articleJsonLd, resolveOgImageWithAlt } from '../../lib/seo';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPublishedArticles();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonicalPath = `/articles/${post.id}/`;
const og = resolveOgImageWithAlt(post.data.previewImage, post.data.previewAlt);
const publishedTime = post.data.date.toISOString();
const jsonLd = articleJsonLd({
  headline: post.data.title,
  description: post.data.description,
  url: absoluteUrl(canonicalPath),
  datePublished: post.data.date,
  image: og.url,
});
---
<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogImage={og.url}
  ogImageAlt={og.alt}
  ogImageIsDefault={og.isDefault}
  publishedTime={publishedTime}
  jsonLd={jsonLd}

  searchable
>
  <header class="page-head">
    <div class="wrap">
      <p class="section-label">Article · {formatItemDate(post.data.date)}</p>
      <h1>{post.data.title}</h1>
    </div>
  </header>
  <div class="page-body">
    <div class="wrap view-prose">
      <Content />
      <p class="view-back">
        <a href="/articles/">← All articles</a>
      </p>
    </div>
  </div>
</BaseLayout>
